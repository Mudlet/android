+std::optional<THeadlessSession::RefusedCertificate> THeadlessSession::refusedCertificate() const
+{
+#if !defined(QT_NO_SSL)
+    if (!mpHost) {
+        return std::nullopt;
+    }
+    cTelnet& telnet = mpHost->mTelnet;
+    const QList<QSslError> refused = telnet.refusedSslErrors();
+    if (refused.isEmpty()) {
+        return std::nullopt;
+    }
+    const QSslCertificate certificate = telnet.getPeerCertificate();
+    RefusedCertificate result;
+    result.issuedTo = certificate.subjectInfo(QSslCertificate::CommonName).join(QLatin1Char(','));
+    result.issuer = certificate.issuerInfo(QSslCertificate::CommonName).join(QLatin1Char(','));
+    result.expires = certificate.expiryDate();
+    result.serial = QString::fromLatin1(certificate.serialNumber());
+    for (const auto& error : refused) {
+        // As cTelnet::finishDisconnection(): the two settings let these past only for the game's own certificate
+        const bool own = error.certificate() == certificate;
+        if (own && error.error() == QSslError::CertificateExpired) {
+            result.expired = true;
+        } else if (own && error.error() == QSslError::SelfSignedCertificate) {
+            result.selfSigned = true;
+        } else {
+            result.others = true;
+        }
+        result.errors.append(error.errorString());
+    }
+    return result;
+#else
+    return std::nullopt;
+#endif
+}
