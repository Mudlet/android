+#include "THeadlessSession.h"
+
+#include "Host.h"
+#include "MudletApp.h"
+
+#include <QFileInfo>
+#include <QPointer>
+
+QList<THeadlessSession::InstalledPackage> THeadlessSession::installedPackages() const
+{
+    QList<InstalledPackage> packages;
+    if (!mpHost) {
+        return packages;
+    }
+    const QString profile = mpHost->getName();
+    for (const QString& name : std::as_const(mpHost->mInstalledPackages)) {
+        const QMap<QString, QString> details = mpHost->mPackageInfo.value(name);
+        InstalledPackage package{name, details.value(qsl("title")), details.value(qsl("author")), details.value(qsl("version")), details.value(qsl("description")), {}};
+        // As dlgPackageManager shows them
+        package.description.replace(QLatin1String("$packagePath"), MudletApp::getMudletPath(enums::profileDataItemPath, profile, name));
+        if (const QString icon = details.value(qsl("icon")); !icon.isEmpty()) {
+            const QString path = MudletApp::getMudletPath(enums::profileDataItemPath, profile, qsl("%1/.mudlet/Icon/%2").arg(name, icon));
+            if (QFileInfo(path).isFile()) {
+                package.icon = path;
+            }
+        }
+        packages.append(package);
+    }
+    return packages;
+}
+
+bool THeadlessSession::uninstallPackage(const QString& name)
+{
+    if (!usable()) {
+        return false;
+    }
+    const auto notInstalled = [this, &name]() {
+        //: Error from a frontend with no window asked to remove a package that is not installed, as the Package Manager says it; %1 is the package's name
+        mErrorString = tr("The package \"%1\" is no longer installed, so there was nothing to remove.").arg(name);
+        return false;
+    };
+    if (!mpHost->mInstalledPackages.contains(name)) {
+        return notInstalled();
+    }
+    // Its sysUninstall handlers may close the profile, and a function the frontend bound into Lua delete the session
+    const QPointer<THeadlessSession> self(this);
+    const bool removed = mpHost->uninstallPackage(name, enums::PackageModuleType::Package);
+    if (removed || !self) {
+        return removed;
+    }
+    // As dlgPackageManager::removePackages() tells them apart: otherwise a handler of the removal took it first
+    if (!mpHost || !mpHost->currentlySavingProfile()) {
+        return notInstalled();
+    }
+    //: Error from a frontend with no window asked to remove a package while the profile was being saved, as the Package Manager says it; %1 is the package's name
+    mErrorString = tr("The package \"%1\" could not be removed while the profile is being saved. Please try again in a moment.").arg(name);
+    return false;
+}
+
+void THeadlessSession::connectPackageRelays(Host* pHost, const unsigned int run)
+{
+    connect(pHost, &Host::signal_packageListChanged, this, [this, run]() {
+        if (run != mRun || !mpHost || mPackagesQueuedRun == run) {
+            return;
+        }
+        mPackagesQueuedRun = run;
+        QMetaObject::invokeMethod(
+                this,
+                [this, run]() {
+                    if (mPackagesQueuedRun == run) {
+                        mPackagesQueuedRun = 0;
+                    }
+                    if (run == mRun && mpHost) {
+                        const QString profile = mProfileName;
+                        emit packagesChanged(profile);
+                    }
+                },
+                Qt::QueuedConnection);
+    });
+}
