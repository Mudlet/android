+-- The compact layout, for a main window with a compact width or height: no dock
+-- and no map, since the frontend's own map is the one that fits a screen that
+-- size, only the bars along the top and a button for each chat tab along the
+-- bottom. A button opens its tab over the game's text and closes it again, the
+-- way Mudlet Web's phone layout switches between its panels from a row of buttons
+-- under them. Sizes are in the main window's logical pixels, getMainWindowInfo()'s
+-- pixelScale Mudlet pixels each, so a button is as big under a finger on a dense
+-- phone screen as it is on a desktop. The buttons are 48 tall, the smallest touch
+-- target Android's accessibility guidelines allow, as a frontend that grows a
+-- smaller one to that is stopped by an open tab right above it.
+local compact = {
+  barHeight = 26, barPadding = 3, barGap = 6,
+  buttonHeight = 48, rowPadding = 4, buttonGap = 4,
+}
+
+-- Locked, and attached to its border, so the console gives it room the way it
+-- gives the dock room and other scripts' containers on that border share it
+local function compactStrip(name, border, style)
+  local strip = Adjustable.Container:new({
+    name = name,
+    x = "0%", y = border == "top" and "0%" or "-1", width = "100%", height = 1,
+    attached = border,
+    attachedMargin = 0,
+    padding = 0,
+    autoLoad = false,
+    autoSave = false,
+  })
+  -- not locked by the constructor: it locks before attaching, and locking reserves
+  -- the border from a list of that border's containers made only on attaching
+  strip:lockContainer("full")
+  -- a right-click would open Adjustable's menu, whose items unlock, move and close it
+  strip.adjLabel:setClickCallback(function() end)
+  -- that callback would have a screen reader call the strip a button
+  strip.adjLabel:setAccessibleRole("text")
+  -- set after locking: the "full" lock style zeroes every border width
+  strip.adjLabelstyle = style
+  strip.adjLabel:setStyleSheet(style)
+  return strip
+end
+
+local function createCompactWidgets()
+  BaseUI.vitalsBar = compactStrip("BaseUI_vitals_bar", "top", css.vitalsBar)
+  BaseUI.chatButtonRow = compactStrip("BaseUI_chat_buttons", "bottom", css.chatButtonRow)
+  BaseUI.chatSheet = Geyser.Container:new({
+    name = "BaseUI_chat_sheet",
+    x = 0, y = 0, width = 1, height = 1,
+  })
+  BaseUI.chatButtons = {}
+  BaseUI.buttonPainted = {}
+  for _, tab in ipairs(chatTabs) do
+    local button = Geyser.Label:new({
+      name = "BaseUI_chat_button_" .. tab.key,
+      x = 0, y = 0, width = 1, height = 1,
+      font = theme.font, fontSize = 10, format = "c",
+    }, BaseUI.chatButtonRow.Inside)
+    button:setClickCallback(BaseUI.toggleChat, tab.key)
+    BaseUI.chatButtons[tab.key] = button
+  end
+end
+
+-- Geyser keeps a strip's height and its distance from the edge as separate
+-- constraints, so both change together, as fitDockWidth does for the dock
+local function sizeStrip(strip, border, height)
+  if strip.height == height then
+    return
+  end
+  strip.height = height
+  if border == "bottom" then
+    strip.y = "-" .. height
+  end
+  strip:set_constraints(strip)
+  strip:adjustBorder()
+end
+
+-- A widget the hidden dock hid along with itself comes out hidden by its parent;
+-- show(true) clears just that, so a bar or a pane hidden on purpose stays hidden
+local function moveInto(widget, container)
+  if widget.container ~= container then
+    widget:changeContainer(container)
+    widget:show(true)
+  end
+end
+
+-- Two bars to a row with the window upright and all of them in one row on its side,
+-- in vitalsStats order like the dock's
+local function layoutVitalsBar(scale, upright)
+  local bar, slots = BaseUI.vitalsBar, BaseUI.usedGaugeSlots
+  if slots == 0 then
+    bar:hide()
+    return
+  end
+  bar:show()
+  local columns = math.min(slots, upright and 2 or maxGaugeSlots)
+  local padding, gap = compact.barPadding * scale, compact.barGap * scale
+  local height = compact.barHeight * scale
+  sizeStrip(bar, "top", math.floor(math.ceil(slots / columns) * height + 2 * padding))
+  local width = (bar:get_width() - 2 * padding - (columns - 1) * gap) / columns
+  local index = 0
+  for _, stat in ipairs(vitalsStats) do
+    local gauge = BaseUI.gauges[stat.key]
+    if gauge then
+      moveInto(gauge, bar.Inside)
+      local column, row = index % columns, math.floor(index / columns)
+      gauge:move(math.floor(padding + column * (width + gap)), math.floor(padding + row * height))
+      gauge:resize(math.floor(width), math.floor(height))
+      index = index + 1
+    end
+  end
+end
