+// The bindings KeyUnit::firstMatch() can reach: each switched on, in folders switched on
+void appendMatchedKeys(Host& host, std::vector<int>& combinations)
+{
+    if (host.isClosingDown()) {
+        return;
+    }
+    const QMap<int, TKey*> keys = host.getKeyUnit()->getKeyList();
+    for (const TKey* pKey : keys) {
+        if (!pKey || pKey->isFolder() || !pKey->isActive()) {
+            continue;
+        }
+        bool reached = true;
+        for (const TKey* pFolder = pKey->getParent(); pFolder && reached; pFolder = pFolder->getParent()) {
+            reached = pFolder->isActive();
+        }
+        if (reached) {
+            combinations.push_back(QKeyCombination(pKey->getKeyModifiers(), pKey->getKeyCode()).toCombined());
+        }
+    }
+}
+
+// What keyBindings() follows from, cheaper to compare than it: the matching keys, hidden input and the caret-mode key
+void noteKeyBindingsState(Host& host, std::vector<int>& state)
+{
+    state.clear();
+    appendMatchedKeys(host, state);
+    state.push_back(host.passwordEntryWanted());
+    state.push_back(static_cast<int>(host.mCaretShortcut));
+}
+
+// Whether offerKey() offers the bindings a key given no text, ahead of the line's own keys or after them
+bool bindingsOffered(const Host& host, const QKeyCombination combination, const bool hiddenInput)
+{
+    const QKeyEvent event(QEvent::KeyPress, combination.key(), combination.keyboardModifiers());
+    if (hiddenInput) {
+        return !hiddenInputKeepsKey(host, event, nullptr);
+    }
+    return (combination.keyboardModifiers() & Qt::KeypadModifier) || !commandLineKeepsKey(host, event);
+}
+
