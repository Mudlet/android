+std::optional<THeadlessSession::LuaProblem> THeadlessSession::checkLua(const QString& code)
+{
+    lua_State* L = luaL_newstate();
+    if (!L) {
+        return LuaProblem{0, qsl("not enough memory")};
+    }
+    std::optional<LuaProblem> problem;
+    const QByteArray utf8 = code.toUtf8();
+    // "=code" names the chunk as is, so a message starts "code:<line>: "
+    if (luaL_loadbuffer(L, utf8.constData(), utf8.size(), "=code") != 0) {
+        const QString message = lua_isstring(L, -1) ? QString::fromUtf8(lua_tostring(L, -1)) : qsl("it does not compile");
+        static const QRegularExpression where(qsl("^code:(\\d+): "));
+        const QRegularExpressionMatch match = where.match(message);
+        problem = match.hasMatch() ? LuaProblem{match.captured(1).toInt(), message.mid(match.capturedLength())} : LuaProblem{0, message};
+    }
+    lua_close(L);
+    return problem;
+}
