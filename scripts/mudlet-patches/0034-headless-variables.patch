 namespace {
 
+THeadlessSession::VariableType variableType(const int luaType)
+{
+    using Type = THeadlessSession::VariableType;
+    switch (luaType) {
+    case LUA_TBOOLEAN:
+        return Type::boolean;
+    case LUA_TNUMBER:
+        return Type::number;
+    case LUA_TSTRING:
+        return Type::string;
+    case LUA_TTABLE:
+        return Type::table;
+    case LUA_TFUNCTION:
+        return Type::function;
+    default:
+        return Type::other;
+    }
+}
+
+} // namespace
+
+THeadlessSession::VariableListing THeadlessSession::variables(const QList<VariableKey>& path, const bool showHidden)
+{
+    VariableListing listing;
+    if (!usable()) {
+        return listing;
+    }
+    LuaInterface* lua = mpHost->getLuaInterface();
+    // Read afresh each time, as the Variables view does when it is shown: the next walk, a profile save's among them,
+    // frees the TVars of this one
+    lua->getVars(false);
+    VarUnit* varUnit = lua->getVarUnit();
+    TVar* table = varUnit->getBase();
+    for (const VariableKey& key : path) {
+        const QList<TVar*> members = table->getChildren(false);
+        const auto member = std::find_if(members.cbegin(), members.cend(), [&key](TVar* var) {
+            return var->getValueType() == LUA_TTABLE && var->getName() == key.name && variableType(var->getKeyType()) == key.keyType;
+        });
+        if (member == members.cend()) {
+            //: Error from a frontend with no window that asked for the members of a Lua table that is not there, or no longer
+            mErrorString = tr("There is no such table.");
+            return listing;
+        }
+        table = *member;
+    }
+    listing.found = true;
+    for (TVar* var : table->getChildren(true)) {
+        const bool hidden = varUnit->isHidden(var);
+        if (hidden && !showHidden) {
+            ++listing.hiddenLeftOut;
+            continue;
+        }
+        Variable variable{.key = {var->getName(), variableType(var->getKeyType())}, .type = variableType(var->getValueType()), .hidden = hidden};
+        if (variable.type == VariableType::table) {
+            const QList<TVar*> members = var->getChildren(false);
+            variable.members = members.size();
+            variable.membersIndexed = !members.isEmpty() && std::all_of(members.cbegin(), members.cend(), [](TVar* member) {
+                return member->getKeyType() == LUA_TNUMBER;
+            });
+        } else if (variable.type != VariableType::function) {
+            variable.value = var->getValue();
+        }
+        listing.variables.append(variable);
+    }
+    return listing;
+}
