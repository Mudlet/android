+local chatWelcome = "&lt;150,158,167&gt;Tells, says and channel chat from the game will be collected here.\n"
+
+local function showChatWelcome()
+  local pane = BaseUI.chats.all
+  pane:clear()
+  pane:decho(chatWelcome)
+  BaseUI.chatWelcomeWrap = pane.wrapAt
+end
+
+-- Printed lines keep the wrap they had, so a welcome printed before the window had
+-- its size is printed again at the new width, but only while it is all "All" holds
+local function refitChatWelcome()
+  local pane = BaseUI.chats and BaseUI.chats.all
+  if not pane or not BaseUI.chatWelcomeWrap or pane.wrapAt == BaseUI.chatWelcomeWrap then
+    return
+  end
+  local held = table.concat(getLines(pane.name, 0, getLineCount(pane.name)) or {}):gsub("%s", "")
+  if held ~= decho2string(chatWelcome):gsub("%s", "") then
+    BaseUI.chatWelcomeWrap = nil
+    return
+  end
+  showChatWelcome()
+end
+
