+namespace {
+
+// Lua names a chunk by the first line of its name, cut to fit LUA_IDSIZE with "..." after it
+bool chunkNames(const QString& chunk, const QString& name)
+{
+    if (chunk.endsWith(QLatin1String("..."))) {
+        return name.startsWith(chunk.chopped(3));
+    }
+    return chunk == name.section(QLatin1Char('\n'), 0, 0);
+}
+
+template <class T>
+void findNamed(Host& host, T* pItem, const QString& chunk, QList<T*>& found)
+{
+    if (!shown(host, pItem)) {
+        return;
+    }
+    if (!pItem->isFolder() && chunkNames(chunk, pItem->getName())) {
+        found.append(pItem);
+    }
+    for (auto* pChild : *pItem->getChildrenList()) {
+        findNamed(host, static_cast<T*>(pChild), chunk, found);
+    }
+}
+
+} // namespace
+
+THeadlessSession::ErrorConsoleEntry THeadlessSession::errorConsoleEntryOf(const QString& object, const QString& function, const QString& event, const QString& message, const bool debug) const
+{
+    ErrorConsoleEntry entry{debug, object, function, event, message};
+    entry.msecs = QDateTime::currentMSecsSinceEpoch();
+    if (debug || !mpHost) {
+        return entry;
+    }
+    // A trigger's, alias's, timer's, key's or button's Lua function is named for its id, unlike its chunk, whose name
+    // two items may share
+    static const QRegularExpression functionOfItem(QStringLiteral(R"(^(Trigger|Alias|Timer|Key|Action)(\d+)$)"));
+    static const QRegularExpression chunkLine(QStringLiteral(R"re(\[string "(Trigger|Alias|Script|Timer|Key|Button): ([^"]*)"\]:(\d+):)re"));
+    static const QMap<QString, Kind> kindOfWord{{QStringLiteral("Trigger"), Kind::trigger},
+                                                {QStringLiteral("Alias"), Kind::alias},
+                                                {QStringLiteral("Script"), Kind::script},
+                                                {QStringLiteral("Timer"), Kind::timer},
+                                                {QStringLiteral("Key"), Kind::key},
+                                                {QStringLiteral("Action"), Kind::button},
+                                                {QStringLiteral("Button"), Kind::button}};
+    const QRegularExpressionMatch chunk = chunkLine.match(message);
+    const std::optional<Kind> chunkKind = chunk.hasMatch() ? std::optional(kindOfWord.value(chunk.captured(1))) : std::nullopt;
+    if (const QRegularExpressionMatch match = functionOfItem.match(function); match.hasMatch()) {
+        const Kind kind = kindOfWord.value(match.captured(1));
+        const int id = match.captured(2).toInt();
+        withItemClass(kind, [&](auto* pClass) {
+            using T = std::remove_pointer_t<decltype(pClass)>;
+            if (T* pItem = shownItem<T>(*mpHost, id)) {
+                entry.kind = kind;
+                entry.id = id;
+                if (chunkKind == kind && chunkNames(chunk.captured(2), pItem->getName())) {
+                    entry.line = chunk.captured(3).toInt();
+                }
+            }
+            return true;
+        });
+        return entry;
+    }
+    if (!chunkKind) {
+        return entry;
+    }
+    withItemClass(*chunkKind, [&](auto* pClass) {
+        using T = std::remove_pointer_t<decltype(pClass)>;
+        QList<T*> found;
+        for (T* pItem : rootItems<T>(*mpHost)) {
+            findNamed(*mpHost, pItem, chunk.captured(2), found);
+        }
+        if (found.size() == 1) {
+            entry.kind = *chunkKind;
+            entry.id = found.first()->getID();
+            entry.line = chunk.captured(3).toInt();
+        }
+        return true;
+    });
+    return entry;
+}
