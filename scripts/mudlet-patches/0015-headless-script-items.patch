+#include <QRegularExpression>
+
+#include <algorithm>
+#include <limits>
+#include <type_traits>
+
+// TTrigger, TAlias and TScript share nothing but Tree<T>, so what is the same for the three is written once over it
+
+namespace {
+
+using Kind = THeadlessSession::ScriptItemKind;
+
+// By Mudlet's REGEX_ numbers, which a trigger's pattern kinds are
+const QStringList& patternTypes()
+{
+    static const QStringList types{qsl("substring"), qsl("regex"), qsl("startOfLine"), qsl("exact"), qsl("lua"), qsl("spacer"), qsl("color"), qsl("prompt")};
+    return types;
+}
+
+// count: from 0; lineDelta: from -1, which stands for none
+enum class FieldType { text, flag, count, lineDelta, textList, patterns, color };
+
+const QMap<QString, FieldType>& editableFields(const Kind kind)
+{
+    static const QMap<QString, FieldType> trigger{{qsl("name"), FieldType::text},
+                                                  {qsl("script"), FieldType::text},
+                                                  {qsl("patterns"), FieldType::patterns},
+                                                  {qsl("command"), FieldType::text},
+                                                  {qsl("lineDelta"), FieldType::lineDelta},
+                                                  {qsl("matchAll"), FieldType::flag},
+                                                  {qsl("filter"), FieldType::flag},
+                                                  {qsl("fireLength"), FieldType::count},
+                                                  {qsl("sound"), FieldType::flag},
+                                                  {qsl("soundFile"), FieldType::text},
+                                                  {qsl("highlight"), FieldType::flag},
+                                                  {qsl("highlightFg"), FieldType::color},
+                                                  {qsl("highlightBg"), FieldType::color}};
+    static const QMap<QString, FieldType> alias{{qsl("name"), FieldType::text}, {qsl("script"), FieldType::text}, {qsl("pattern"), FieldType::text}, {qsl("command"), FieldType::text}};
+    static const QMap<QString, FieldType> script{{qsl("name"), FieldType::text}, {qsl("script"), FieldType::text}, {qsl("eventHandlers"), FieldType::textList}};
+    switch (kind) {
+    case Kind::trigger:
+        return trigger;
+    case Kind::alias:
+        return alias;
+    case Kind::script:
+        break;
+    }
+    return script;
+}
+
+// A whole number, as a frontend's JSON may give it as a double
+std::optional<int> wholeNumber(const QVariant& value)
+{
+    switch (value.typeId()) {
+    case QMetaType::Int:
+    case QMetaType::UInt:
+    case QMetaType::LongLong:
+    case QMetaType::ULongLong:
+    case QMetaType::Double: {
+        const double number = value.toDouble();
+        if (number >= std::numeric_limits<int>::min() && number <= std::numeric_limits<int>::max() && number == static_cast<double>(static_cast<int>(number))) {
+            return static_cast<int>(number);
+        }
+        return std::nullopt;
+    }
+    default:
+        return std::nullopt;
+    }
+}
+
+bool colorFits(const QVariant& value)
+{
+    static const QRegularExpression rgb(qsl("^(#[0-9A-Fa-f]{6})?$"));
+    return value.typeId() == QMetaType::QString && rgb.match(value.toString()).hasMatch();
+}
+
+QString colorText(const QColor& color)
+{
+    return color.isValid() && color.alpha() ? color.name() : QString();
+}
+
+bool fitsField(const FieldType type, const QVariant& value)
+{
+    switch (type) {
+    case FieldType::text:
+        return value.typeId() == QMetaType::QString;
+    case FieldType::flag:
+        return value.typeId() == QMetaType::Bool;
+    case FieldType::count:
+        return wholeNumber(value).value_or(-1) >= 0;
+    case FieldType::lineDelta:
+        return wholeNumber(value).value_or(-2) >= -1;
+    case FieldType::color:
+        return colorFits(value);
+    case FieldType::textList: {
+        if (value.typeId() != QMetaType::QVariantList) {
+            return false;
+        }
+        const QVariantList entries = value.toList();
+        return std::all_of(entries.cbegin(), entries.cend(), [](const QVariant& entry) {
+            return entry.typeId() == QMetaType::QString;
+        });
+    }
+    case FieldType::patterns: {
+        if (value.typeId() != QMetaType::QVariantList) {
+            return false;
+        }
+        const QVariantList entries = value.toList();
+        return std::all_of(entries.cbegin(), entries.cend(), [](const QVariant& entry) {
+            if (entry.typeId() != QMetaType::QVariantMap) {
+                return false;
+            }
+            const QVariantMap pattern = entry.toMap();
+            return pattern.size() == 2 && pattern.value(qsl("text")).typeId() == QMetaType::QString && patternTypes().contains(pattern.value(qsl("type")).toString());
+        });
+    }
+    }
+    return false;
+}
+
+template <class T>
+std::list<T*> rootItems(Host& host)
+{
+    if constexpr (std::is_same_v<T, TTrigger>) {
+        return host.getTriggerUnit()->getTriggerRootNodeList();
+    } else if constexpr (std::is_same_v<T, TAlias>) {
+        return host.getAliasUnit()->getAliasRootNodeList();
+    } else {
+        return host.getScriptUnit()->getScriptRootNodeList();
+    }
+}
+
+template <class T>
+bool shown(Host& host, T* pItem)
+{
+    if (pItem->isTemporary()) {
+        return false;
+    }
+    if constexpr (std::is_same_v<T, TTrigger>) {
+        return !host.getTriggerUnit()->pendingDeletion(pItem);
+    } else if constexpr (std::is_same_v<T, TAlias>) {
+        return !host.getAliasUnit()->pendingDeletion(pItem);
+    } else {
+        return !host.getScriptUnit()->pendingDeletion(pItem);
+    }
+}
+
+template <class T>
+T* shownItem(Host& host, const int id)
+{
+    T* pItem = nullptr;
+    if constexpr (std::is_same_v<T, TTrigger>) {
+        pItem = host.getTriggerUnit()->getTrigger(id);
+    } else if constexpr (std::is_same_v<T, TAlias>) {
+        pItem = host.getAliasUnit()->getAlias(id);
+    } else {
+        pItem = host.getScriptUnit()->getScript(id);
+    }
+    return pItem && shown(host, pItem) ? pItem : nullptr;
+}
+
+template <class T>
+void reParent(Host& host, T* pItem, const int parentId, const std::optional<int> position)
+{
+    const int oldParentId = pItem->getParent() ? pItem->getParent()->getID() : 0;
+    const TreeItemInsertMode mode = position ? TreeItemInsertMode::AtPosition : TreeItemInsertMode::Append;
+    if constexpr (std::is_same_v<T, TTrigger>) {
+        host.getTriggerUnit()->reParentTrigger(pItem->getID(), oldParentId, parentId, mode, position.value_or(0));
+    } else if constexpr (std::is_same_v<T, TAlias>) {
+        host.getAliasUnit()->reParentAlias(pItem->getID(), oldParentId, parentId, mode, position.value_or(0));
+    } else {
+        host.getScriptUnit()->reParentScript(pItem->getID(), oldParentId, parentId, mode, position.value_or(0));
+    }
+}
+
+// Where, among all of a folder's items or the top level's with the moving item taken out, the shown one at position
+// is, as the units' reParent...() count temporary items too; none to append
+template <class T>
+std::optional<int> unitPosition(Host& host, T* pParent, const T* pMoving, const int position)
+{
+    std::list<T*> siblings;
+    if (pParent) {
+        for (auto* pChild : *pParent->getChildrenList()) {
+            siblings.push_back(static_cast<T*>(pChild));
+        }
+    } else {
+        siblings = rootItems<T>(host);
+    }
+    int index = 0;
+    int shownIndex = 0;
+    for (T* pSibling : siblings) {
+        if (pSibling == pMoving) {
+            continue;
+        }
+        if (shown(host, pSibling) && shownIndex++ == position) {
+            return index;
+        }
+        ++index;
+    }
+    return std::nullopt;
+}
+
+template <class T>
+QString packageOf(const T* pItem)
+{
+    for (const T* pAncestor = pItem; pAncestor; pAncestor = pAncestor->getParent()) {
+        if (!pAncestor->mPackageName.isEmpty()) {
+            return pAncestor->mPackageName;
+        }
+    }
+    return {};
+}
+
+template <class T>
+QString errorOf(T* pItem)
+{
+    return pItem->state() ? QString() : TLuaInterpreter::compileErrorAsPlainText(pItem->getError());
+}
+
+template <class T>
+THeadlessSession::ScriptItemNode nodeOf(T* pItem)
+{
+    THeadlessSession::ScriptItemNode node;
+    node.id = pItem->getID();
+    node.parent = pItem->getParent() ? pItem->getParent()->getID() : 0;
+    node.name = pItem->getName();
+    node.folder = pItem->isFolder();
+    node.enabled = pItem->shouldBeActive();
+    node.active = pItem->isActive() && pItem->ancestorsActive();
+    node.package = packageOf(pItem);
+    node.error = errorOf(pItem);
+    return node;
+}
+
+template <class T>
+void appendShown(Host& host, T* pItem, QList<THeadlessSession::ScriptItemNode>& nodes)
+{
+    if (!shown(host, pItem)) {
+        return;
+    }
+    nodes.append(nodeOf(pItem));
+    for (auto* pChild : *pItem->getChildrenList()) {
+        appendShown(host, static_cast<T*>(pChild), nodes);
+    }
+}
+
+template <class T>
+QList<THeadlessSession::ScriptItemNode> shownItems(Host& host)
+{
+    QList<THeadlessSession::ScriptItemNode> nodes;
+    for (T* pItem : rootItems<T>(host)) {
+        appendShown(host, pItem, nodes);
+    }
+    return nodes;
+}
+
+QVariantMap fieldsOf(TTrigger* pItem)
+{
+    QVariantList patterns;
+    const QStringList& texts = pItem->getPatternsList();
+    const QList<int> kinds = pItem->getRegexCodePropertyList();
+    for (qsizetype i = 0; i < texts.size() && i < kinds.size(); ++i) {
+        patterns.append(QVariantMap{{qsl("text"), texts.at(i)}, {qsl("type"), patternTypes().value(kinds.at(i), patternTypes().constFirst())}});
+    }
+    return {{qsl("patterns"), patterns},
+            {qsl("command"), pItem->getCommand()},
+            // As the editor shows it: -1 for a trigger of one line
+            {qsl("lineDelta"), pItem->isMultiline() ? pItem->getConditionLineDelta() : -1},
+            {qsl("matchAll"), pItem->mPerlSlashGOption},
+            {qsl("filter"), pItem->mFilterTrigger},
+            {qsl("fireLength"), pItem->mStayOpen},
+            {qsl("sound"), pItem->mSoundTrigger},
+            {qsl("soundFile"), pItem->mSoundFile},
+            {qsl("highlight"), pItem->isColorizerTrigger()},
+            {qsl("highlightFg"), colorText(pItem->getFgColor())},
+            {qsl("highlightBg"), colorText(pItem->getBgColor())}};
+}
+
+QVariantMap fieldsOf(TAlias* pItem)
+{
+    return {{qsl("pattern"), pItem->getRegexCode()}, {qsl("command"), pItem->getCommand()}};
+}
+
+QVariantMap fieldsOf(TScript* pItem)
+{
+    return {{qsl("eventHandlers"), QVariant(pItem->getEventHandlerList())}};
+}
+
+template <class T>
+QVariantMap itemFields(T* pItem)
+{
+    QVariantMap fields = fieldsOf(pItem);
+    const THeadlessSession::ScriptItemNode node = nodeOf(pItem);
+    fields.insert(qsl("id"), node.id);
+    fields.insert(qsl("parent"), node.parent);
+    fields.insert(qsl("name"), node.name);
+    fields.insert(qsl("folder"), node.folder);
+    fields.insert(qsl("enabled"), node.enabled);
+    fields.insert(qsl("active"), node.active);
+    fields.insert(qsl("package"), node.package);
+    fields.insert(qsl("error"), node.error);
+    fields.insert(qsl("script"), pItem->getScript());
+    return fields;
+}
+
+// As the editor's save: a new item that compiled runs, unless the emergency stop is on, whose resume starts it
+template <class T>
+void startIfNew(Host& host, T* pItem, const bool heedEmergencyStop)
+{
+    if (pItem->state() && pItem->checkIfNew()) {
+        if (pItem->shouldBeActive() && !(heedEmergencyStop && host.mEmergencyStop)) {
+            pItem->setIsActive(true);
+        }
+        pItem->unmarkAsNew();
+    }
+}
+
+void saveItem(Host& host, TTrigger* pItem, const QVariantMap& fields)
+{
+    QStringList patterns;
+    QList<int> kinds;
+    const QVariantList entries = fields.value(qsl("patterns")).toList();
+    for (const QVariant& entry : entries) {
+        const QVariantMap pattern = entry.toMap();
+        const QString text = pattern.value(qsl("text")).toString();
+        const int kind = patternTypes().indexOf(pattern.value(qsl("type")).toString());
+        if (text.isEmpty() && kind != REGEX_PROMPT && kind != REGEX_LINE_SPACER) {
+            continue;
+        }
+        patterns << text;
+        kinds << kind;
+    }
+    const int lineDelta = fields.value(qsl("lineDelta")).toInt();
+    pItem->setName(fields.value(qsl("name")).toString().trimmed());
+    pItem->setCommand(fields.value(qsl("command")).toString());
+    pItem->setRegexCodeList(patterns, kinds);
+    pItem->setScript(fields.value(qsl("script")).toString());
+    pItem->setIsMultiline(lineDelta > -1 && patterns.size() > 1);
+    pItem->mPerlSlashGOption = fields.value(qsl("matchAll")).toBool();
+    pItem->mFilterTrigger = fields.value(qsl("filter")).toBool();
+    if (lineDelta >= 0) {
+        pItem->setConditionLineDelta(lineDelta);
+    }
+    pItem->mStayOpen = fields.value(qsl("fireLength")).toInt();
+    pItem->mSoundTrigger = fields.value(qsl("sound")).toBool();
+    pItem->setSound(fields.value(qsl("soundFile")).toString());
+    const QString foreground = fields.value(qsl("highlightFg")).toString();
+    const QString background = fields.value(qsl("highlightBg")).toString();
+    pItem->setColorizerFgColor(foreground.isEmpty() ? QColor(QColorConstants::Transparent) : QColor(foreground));
+    pItem->setColorizerBgColor(background.isEmpty() ? QColor(QColorConstants::Transparent) : QColor(background));
+    pItem->setIsColorizerTrigger(fields.value(qsl("highlight")).toBool());
+    if (pItem->state()) {
+        startIfNew(host, pItem, true);
+    } else {
+        pItem->setIsActive(false);
+    }
+}
+
+void saveItem(Host& host, TAlias* pItem, const QVariantMap& fields)
+{
+    const QString pattern = fields.value(qsl("pattern")).toString();
+    QString name = fields.value(qsl("name")).toString().trimmed();
+    if (name.isEmpty()) {
+        name = pattern.trimmed();
+    }
+    pItem->setName(name);
+    pItem->setCommand(fields.value(qsl("command")).toString());
+    pItem->setRegexCode(pattern);
+    pItem->setScript(fields.value(qsl("script")).toString());
+    startIfNew(host, pItem, true);
+}
+
+void saveItem(Host& host, TScript* pItem, const QVariantMap& fields)
+{
+    pItem->setName(fields.value(qsl("name")).toString().trimmed());
+    pItem->setEventHandlerList(fields.value(qsl("eventHandlers")).toStringList());
+    pItem->setScript(fields.value(qsl("script")).toString());
+    pItem->compileAll();
+    host.getTriggerUnit()->doCleanup();
+    startIfNew(host, pItem, false);
+    // A script that uninstalled its own package as it ran is deleted here, so pItem may be gone after this
+    host.getScriptUnit()->doCleanup();
+}
+
+// As the editor refuses to save one: its replacement would match its own pattern, so it would call itself forever
+bool aliasLoops(const QString& pattern, const QString& replacement)
+{
+    if (pattern.isEmpty()) {
+        return false;
+    }
+    const QRegularExpression regex(pattern);
+    return regex.isValid() && regex.match(replacement).capturedStart() != -1;
+}
+
+// As the editor's add makes one, in its order
+template <class T>
+T* newItem(Host& host, T* pParent, const bool folder, const QString& name)
+{
+    T* pItem = nullptr;
+    if constexpr (std::is_same_v<T, TTrigger>) {
+        pItem = pParent ? new TTrigger(pParent, &host) : new TTrigger(name, {}, {}, false, &host);
+        pItem->setName(name);
+        pItem->setRegexCodeList({}, {}, false);
+    } else if constexpr (std::is_same_v<T, TAlias>) {
+        pItem = pParent ? new TAlias(pParent, &host) : new TAlias(name, &host);
+        pItem->setName(name);
+        pItem->setCommand(QString());
+        pItem->setRegexCode(QString());
+    } else {
+        pItem = pParent ? new TScript(pParent, &host) : new TScript(name, &host);
+        pItem->setName(name);
+    }
+    pItem->setScript(QString());
+    pItem->setIsFolder(folder);
+    pItem->setIsActive(false);
+    pItem->setShouldBeActive(true);
+    if constexpr (std::is_same_v<T, TTrigger>) {
+        pItem->setIsMultiline(false);
+        pItem->mStayOpen = 0;
+        pItem->setConditionLineDelta(0);
+        pItem->registerTrigger();
+    } else if constexpr (std::is_same_v<T, TAlias>) {
+        pItem->registerAlias();
+    } else {
+        pItem->registerScript();
+    }
+    return pItem;
+}
+
+QString noItem(const int id)
+{
+    //: Error from a frontend with no window that was asked for a trigger, alias or script by an id the profile does not have, or has only for one a script made for a while, which the script editor does not show
+    return THeadlessSession::tr("There is no item %1 of that kind.").arg(id);
+}
+
+QString noFolder(const int id)
+{
+    //: Error from a frontend with no window that was asked to put a trigger, alias or script in a folder by an id that is not one of that kind's folders
+    return THeadlessSession::tr("There is no folder %1 of that kind.").arg(id);
+}
+
+} // namespace
+
+QList<THeadlessSession::ScriptItemNode> THeadlessSession::scriptItems(const ScriptItemKind kind) const
+{
+    if (!mpHost) {
+        return {};
+    }
+    switch (kind) {
+    case ScriptItemKind::trigger:
+        return shownItems<TTrigger>(*mpHost);
+    case ScriptItemKind::alias:
+        return shownItems<TAlias>(*mpHost);
+    case ScriptItemKind::script:
+        break;
+    }
+    return shownItems<TScript>(*mpHost);
+}
+
+namespace {
+
+// The calls below each take the item's own class, so they dispatch on kind once, here
+template <class Call>
+auto withItemClass(const Kind kind, Call&& call)
+{
+    switch (kind) {
+    case Kind::trigger:
+        return call(static_cast<TTrigger*>(nullptr));
+    case Kind::alias:
+        return call(static_cast<TAlias*>(nullptr));
+    case Kind::script:
+        break;
+    }
+    return call(static_cast<TScript*>(nullptr));
+}
+
+} // namespace
+
+bool THeadlessSession::scriptItem(const ScriptItemKind kind, const int id, QVariantMap& item)
+{
+    if (!mpHost) {
+        //: Error from a frontend with no window that has no open profile to send to
+        mErrorString = tr("No profile is open.");
+        return false;
+    }
+    return withItemClass(kind, [&](auto* pClass) {
+        using T = std::remove_pointer_t<decltype(pClass)>;
+        T* pItem = shownItem<T>(*mpHost, id);
+        if (!pItem) {
+            mErrorString = noItem(id);
+            return false;
+        }
+        item = itemFields(pItem);
+        return true;
+    });
+}
+
+bool THeadlessSession::scriptItemsWritable()
+{
+    if (!usable()) {
+        return false;
+    }
+    if (mpHost->getTriggerUnit()->processingDepth() || mpHost->getAliasUnit()->processingDepth() || mpHost->getScriptUnit()->processingDepth()) {
+        //: Error from a frontend with no window that was asked to change a trigger, alias or script while one of them was running and waiting on the event loop
+        mErrorString = tr("A trigger, alias or event handler is running; triggers, aliases and scripts cannot be changed until it returns.");
+        return false;
+    }
+    return true;
+}
+
+int THeadlessSession::addScriptItem(const ScriptItemKind kind, const int parent, const int position, const bool folder, const QString& name)
+{
+    if (!scriptItemsWritable()) {
+        return 0;
+    }
+    return withItemClass(kind, [&](auto* pClass) {
+        using T = std::remove_pointer_t<decltype(pClass)>;
+        T* pParent = nullptr;
+        if (parent) {
+            pParent = shownItem<T>(*mpHost, parent);
+            if (!pParent || !pParent->isFolder()) {
+                mErrorString = noFolder(parent);
+                return 0;
+            }
+        }
+        T* pItem = newItem<T>(*mpHost, pParent, folder, name);
+        if (const std::optional<int> place = unitPosition<T>(*mpHost, pParent, pItem, position)) {
+            reParent(*mpHost, pItem, parent, place);
+        }
+        return pItem->getID();
+    });
+}
+
+bool THeadlessSession::editScriptItem(const ScriptItemKind kind, const int id, const QVariantMap& fields)
+{
+    if (!scriptItemsWritable()) {
+        return false;
+    }
+    const QMap<QString, FieldType>& editable = editableFields(kind);
+    for (auto field = fields.cbegin(); field != fields.cend(); ++field) {
+        if (!editable.contains(field.key())) {
+            //: Error from a frontend with no window that was asked to change a field of a trigger, alias or script that it does not have or that cannot be changed; %1 is the field's name, which is not translated
+            mErrorString = tr("\"%1\" is not a field of that kind that can be changed.").arg(field.key());
+            return false;
+        }
+        if (!fitsField(editable.value(field.key()), field.value())) {
+            //: Error from a frontend with no window that was given a value of the wrong type for a field of a trigger, alias or script; %1 is the field's name, which is not translated
+            mErrorString = tr("The value given for \"%1\" is not one it takes.").arg(field.key());
+            return false;
+        }
+    }
+    return withItemClass(kind, [&](auto* pClass) {
+        using T = std::remove_pointer_t<decltype(pClass)>;
+        T* pItem = shownItem<T>(*mpHost, id);
+        if (!pItem) {
+            mErrorString = noItem(id);
+            return false;
+        }
+        QVariantMap merged = itemFields(pItem);
+        for (auto field = fields.cbegin(); field != fields.cend(); ++field) {
+            merged.insert(field.key(), field.value());
+        }
+        if constexpr (std::is_same_v<T, TAlias>) {
+            if (aliasLoops(merged.value(qsl("pattern")).toString(), merged.value(qsl("command")).toString())) {
+                //: Error from a frontend with no window that was asked to save an alias whose replacement text would itself match the alias's pattern
+                mErrorString = tr("The alias's replacement matches its own pattern, so it would call itself forever.");
+                return false;
+            }
+        }
+        saveItem(*mpHost, pItem, merged);
+        return true;
+    });
+}
+
+bool THeadlessSession::setScriptItemEnabled(const ScriptItemKind kind, const int id, const bool enabled)
+{
+    if (!scriptItemsWritable()) {
+        return false;
+    }
+    return withItemClass(kind, [&](auto* pClass) {
+        using T = std::remove_pointer_t<decltype(pClass)>;
+        T* pItem = shownItem<T>(*mpHost, id);
+        if (!pItem) {
+            mErrorString = noItem(id);
+            return false;
+        }
+        pItem->setIsActive(enabled);
+        if (!pItem->state()) {
+            pItem->setIsActive(false);
+            if (enabled) {
+                mErrorString = errorOf(pItem);
+                return false;
+            }
+        }
+        return true;
+    });
+}
+
+bool THeadlessSession::moveScriptItem(const ScriptItemKind kind, const int id, const int parent, const int position)
+{
+    if (!scriptItemsWritable()) {
+        return false;
+    }
+    return withItemClass(kind, [&](auto* pClass) {
+        using T = std::remove_pointer_t<decltype(pClass)>;
+        T* pItem = shownItem<T>(*mpHost, id);
+        if (!pItem) {
+            mErrorString = noItem(id);
+            return false;
+        }
+        T* pParent = nullptr;
+        if (parent) {
+            pParent = shownItem<T>(*mpHost, parent);
+            if (!pParent || !pParent->isFolder()) {
+                mErrorString = noFolder(parent);
+                return false;
+            }
+            for (const T* pAncestor = pParent; pAncestor; pAncestor = pAncestor->getParent()) {
+                if (pAncestor == pItem) {
+                    //: Error from a frontend with no window that was asked to move a folder of triggers, aliases or scripts into itself or into a folder inside it
+                    mErrorString = tr("A folder cannot be moved into itself or into a folder inside it.");
+                    return false;
+                }
+            }
+        }
+        reParent(*mpHost, pItem, parent, unitPosition<T>(*mpHost, pParent, pItem, position));
+        return true;
+    });
+}
+
+bool THeadlessSession::deleteScriptItem(const ScriptItemKind kind, const int id)
+{
+    if (!scriptItemsWritable()) {
+        return false;
+    }
+    return withItemClass(kind, [&](auto* pClass) {
+        using T = std::remove_pointer_t<decltype(pClass)>;
+        T* pItem = shownItem<T>(*mpHost, id);
+        if (!pItem) {
+            mErrorString = noItem(id);
+            return false;
+        }
+        delete pItem;
+        return true;
+    });
+}
