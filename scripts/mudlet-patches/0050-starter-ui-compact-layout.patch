 -- row pulls that section out to sit anywhere over the game's text, the sections
 -- left behind share out the space it had, and where each one was left is
 -- remembered between sessions.
--- It lays itself out for the screen it is on (see BaseUI.screenShape): a dock on
--- the right of a roomy or short window, along the bottom of a narrow one.
+-- A main window of a phone's size gets a layout of its own instead of the dock
+-- (see BaseUI.layoutCompact): the bars along the top, and the chat behind a
+-- button for each tab along the bottom.
 -- Type "baseui" for options; "baseui hide" removes it until "baseui show".
 
 BaseUI = BaseUI or {}
@@ -606,8 +607,6 @@ local layout = {
   -- pixels rather than shares, unlike the sections: the chat section's tab row
   -- and the gap under it
   tabs = 20, tabGap = 4,
-  -- the gap between two bars in a row, as a share of the panel's width
-  barGap = 0.03,
 }
 -- where the bars start, which is everything the dock hands out above them
 layout.barsTop = layout.map.height + layout.map.gap + layout.chat.height + layout.chat.gap
@@ -668,6 +667,8 @@ end
 -- changes; the widgets are then repainted from here.
 local css = {}
 local gaugeDefs = { hp = {}, mp = {}, xp = {}, mv = {}, enemy = {} }
+-- what a screen reader calls each bar
+local gaugeNames = { hp = "Health", mp = "Mana", xp = "Experience", mv = "Movement", enemy = "Enemy" }
 
 -- How much of a background picture the dock's own surfaces hide while one is
 -- showing, as a stylesheet percentage. Floating sections keep their full colour,
@@ -709,6 +710,14 @@ local function rebuildCss(opacity)
     [[background-color: %s; border: 1px solid %s; border-bottom: 2px solid %s; border-top-left-radius: 4px; border-top-right-radius: 4px;]],
     shade(theme.tabInactive, opacity), theme.borderSoft, theme.borderSoft)
   css.gaugeBack = gaugeStyle(theme.gaugeBack)
+  css.vitalsBar = string.format("background-color: %s; border: 0px; border-bottom: 1px solid %s;",
+    shade(theme.panel, opacity), theme.border)
+  css.chatButtonRow = string.format("background-color: %s; border: 0px; border-top: 1px solid %s;",
+    shade(theme.panel, opacity), theme.border)
+  css.chatButton = string.format("background-color: %s; border: 1px solid %s; border-radius: 6px;",
+    theme.tabInactive, theme.border)
+  css.chatButtonOpen = string.format("background-color: %s; border: 1px solid %s; border-radius: 6px;",
+    theme.accent, theme.accent)
   for key, color in pairs(theme.gauges) do
     gaugeDefs[key].front = gaugeStyle(color)
   end
@@ -2063,6 +2072,7 @@ function BaseUI.restyle()
     -- cache; a look change moves both, so every tab repaints
     BaseUI.refreshChatTabs()
   end
+  BaseUI.restyleCompact()
   for key, gauge in pairs(BaseUI.gauges) do
     local def = gaugeDefs[key]
     if def then
@@ -2214,6 +2224,13 @@ function BaseUI.uninstall()
     section:deleteSaveFile()
     pcall(section.delete, section)
   end
+  -- each takes what the compact layout moved into it, and the strips give back their borders
+  for _, name in ipairs({ "vitalsBar", "chatButtonRow", "chatSheet" }) do
+    local widget = BaseUI[name]
+    if widget then
+      pcall(widget.delete, widget)
+    end
+  end
   if BaseUI.container then
     -- takes the palette button and every remaining section with it, and gives
