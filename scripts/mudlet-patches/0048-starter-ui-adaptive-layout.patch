+-- many times its share of the dock a bar takes - a dock along the bottom is about
+-- half as tall as the window, so its bars need twice the share to stay as tall.
+local dockShapes = {
+  roomy = { border = "right", barColumns = 1, barScale = 1 },
+  short = { border = "right", barColumns = 2, barScale = 1 },
+  narrow = { border = "bottom", height = "45%", barColumns = 2, barScale = 2, sideBySide = true },
+}
+
+-- The main window's shape, read from its size classes the way Material reads
+-- them: a compact width is a phone held upright or a narrow window, a compact
+-- height a phone on its side or a short window. The classes are of the main
+-- window rather than of the device, so a small desktop window gets the same
+-- layout as a phone. Mudlets older than getMainWindowInfo() get the roomy layout.
+function BaseUI.screenShape()
+  local info = type(getMainWindowInfo) == "function" and getMainWindowInfo()
+  if type(info) ~= "table" then
+    return "roomy"
+  end
+  if info.widthClass == "compact" then
+    return "narrow"
+  end
+  if info.heightClass == "compact" then
+    return "short"
+  end
+  return "roomy"
+end
+
+local function currentShape()
+  return dockShapes[BaseUI.screenShape()]
+end
