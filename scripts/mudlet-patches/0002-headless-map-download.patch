+// A reply's error text can name its URL, and with it the user name and password a game can put there
+QString withoutUserInfo(QString text, const QNetworkReply& reply)
+{
+    for (const QUrl& url : {reply.request().url(), reply.url()}) {
+        if (!url.userInfo().isEmpty()) {
+            const QString shown = url.toString(QUrl::RemoveUserInfo);
+            text.replace(url.toString(), shown);
+            text.replace(url.toString(QUrl::FullyEncoded), shown);
+            text.replace(url.toDisplayString(), shown);
+        }
+    }
+    return text;
+}
