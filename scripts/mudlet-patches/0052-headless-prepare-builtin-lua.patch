+    // The files of the copy in the library that the folder lacks, or holds at another size
+    QStringList filesMissingFrom(const QString& folder) const
+    {
+        QStringList missing;
+        QDirIterator it(mBuiltinPath, QDir::Files, QDirIterator::Subdirectories);
+        while (it.hasNext()) {
+            const QFileInfo builtin(it.next());
+            const QFileInfo copy(qsl("%1/%2").arg(folder, builtin.filePath().mid(mBuiltinPath.size() + 1)));
