<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. MudletBackupAgent (data/BackupScope.kt) decides what a backup takes, and these rules what a
     restore keeps: never the profiles' passwords, whose key stays in this device's KeyStore (data/PasswordStore.kt);
     never Mudlet's sign-in tokens, which QtKeychain keeps in Qt's settings folder under a KeyStore key of its own; never
     this device's engine state. A rule names a literal path, so the logs in each profile's folder are left out of a
     cloud backup by the agent alone. backup_rules.xml has the same for Android 11 and earlier. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="passwords/" />
        <exclude domain="file" path="settings/" />
        <exclude domain="file" path="engine-session.json" />
        <exclude domain="file" path="engine-stopped" />
        <exclude domain="sharedpref" path="engine.xml" />
        <exclude domain="sharedpref" path="ui.xml" />
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="passwords/" />
        <exclude domain="file" path="settings/" />
        <exclude domain="file" path="engine-session.json" />
        <exclude domain="file" path="engine-stopped" />
        <exclude domain="sharedpref" path="engine.xml" />
        <exclude domain="sharedpref" path="ui.xml" />
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
