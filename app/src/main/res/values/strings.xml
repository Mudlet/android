<?xml version="1.0" encoding="utf-8"?>
<!-- The strings the app shows. app_name comes from app/build.gradle.kts (resValue), as the PTB has a name of its own. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="navigate_back">Back</string>

    <!-- Shown before Android's own notification permission prompt, to say what the notifications are for -->
    <string name="notifications_explanation_title">Allow notifications?</string>
    <string name="notifications_explanation_text">While you use other apps, Mudlet keeps your game connected and your scripts running, and shows a notification you can quit it from. Your scripts can also notify you, for example of a tell.</string>
    <string name="notifications_explanation_continue">Continue</string>
    <string name="notifications_explanation_not_now">Not now</string>

    <string name="profiles_title">Profiles</string>
    <string name="profiles_empty">Your games will be listed here.</string>
    <string name="profiles_open_game">Open the game screen</string>

    <string name="game_title">Game</string>

    <!-- The game screen's console: the button back to the newest text, shown while the player is scrolled up -->
    <string name="console_jump_to_bottom">Jump to the bottom</string>
    <plurals name="console_jump_new_lines">
        <item quantity="one">Jump to the bottom: %1$d new line</item>
        <item quantity="other">Jump to the bottom: %1$d new lines</item>
    </plurals>

    <!-- The game screen's input line, where the player types commands for the game -->
    <string name="input_label">Command</string>
    <string name="input_send">Send</string>
    <string name="input_history_previous">Previous command</string>
    <string name="input_history_next">Next command</string>
    <string name="input_not_sent">Not sent: the app is not connected to the engine</string>
    <!-- The button, also the Tab key, that completes the word being typed from the words the game sent -->
    <string name="input_complete">Complete the word</string>
    <string name="input_no_completion">No completion</string>
    <!-- The masked field that takes the input line's place while the game asks for a password -->
    <string name="input_password_label">Password</string>
    <string name="input_password_close">Close the password field</string>
    <!-- A button above the input line that puts a suggested command, or word, on the line without sending it; %1$s is
         the command or word -->
    <string name="input_suggestion">Suggestion: %1$s</string>
    <!-- The button, also the right arrow key at the end of the line, that completes the line with the suggestion shown
         greyed after it; %1$s is the whole line it gives -->
    <string name="input_accept_suggestion">Accept the suggestion: %1$s</string>

    <!-- The row of buttons below the input line: the button that opens the command history, then a button for each
         command the player pinned, which sends it; %1$s is the command -->
    <string name="history_open">History</string>
    <string name="pinned_command">Pinned: %1$s</string>
    <!-- The command history: a sheet over the game screen, opened by the History button or Ctrl+R, that searches
         the commands the player sent; each row puts its command on the input line, and has buttons that send, pin
         or unpin, and forget it; %1$s is the command -->
    <string name="history_title">Command history</string>
    <string name="history_close">Close the history</string>
    <string name="history_search">Search the history</string>
    <string name="history_pinned">Pinned</string>
    <string name="history_sent">Sent</string>
    <string name="history_empty">No commands sent yet</string>
    <string name="history_no_match">No command matches</string>
    <string name="history_put_on_line">put it on the command line</string>
    <string name="history_send">Send %1$s</string>
    <string name="history_pin">Pin %1$s</string>
    <string name="history_unpin">Unpin %1$s</string>
    <string name="history_forget">Forget %1$s</string>
    <!-- Shown when the player tries to pin a command while as many are pinned as can be; %1$d is that number -->
    <plurals name="history_pins_full">
        <item quantity="one">%1$d command is pinned, the most there can be: unpin it first</item>
        <item quantity="other">%1$d commands are pinned, the most there can be: unpin one first</item>
    </plurals>

    <!-- The game screen's connection bar: the state of the connection to the game, and its buttons -->
    <string name="connection_no_engine">Waiting for the engine…</string>
    <string name="connection_disconnected">Disconnected</string>
    <string name="connection_connecting">Connecting…</string>
    <!-- %1$s is the game's address, as host:port -->
    <string name="connection_connecting_to">Connecting to %1$s…</string>
    <string name="connection_connected">Connected</string>
    <!-- %1$s is the engine's reason, in English -->
    <string name="connection_error">Connection error: %1$s</string>
    <string name="connection_reconnect">Reconnect</string>
    <string name="connection_disconnect">Disconnect</string>

    <!-- Lines the app adds to the console between the game's own. The dashes set them apart from the game's text. -->
    <string name="marker_new_engine" tools:ignore="TypographyDashes">--- new engine instance %1$s ---</string>
    <plurals name="marker_lines_skipped" tools:ignore="TypographyDashes">
        <item quantity="one">--- %1$d line skipped while the UI lagged ---</item>
        <item quantity="other">--- %1$d lines skipped while the UI lagged ---</item>
    </plurals>

    <!-- The self-test: debug builds only, for developers, so not translated -->
    <string name="selftest_title" translatable="false">Self-test</string>
    <string name="selftest_qt_start" translatable="false">Qt up %1$s ms after Application.onCreate (:engine), %2$s ms after Service.onCreate; UI start->hello %3$s</string>
    <string name="selftest_hello_ms" translatable="false">%1$s ms</string>
    <string name="selftest_hello_none" translatable="false">- (engine was already up)</string>
    <string name="selftest_font" translatable="false">Font %1$s, \'M\' %2$s px @14px, screen %3$s x %4$s characters, QPA %5$s</string>
    <string name="selftest_counts" translatable="false">Lines %1$s, prompts %2$s, Lua onLine %3$s, notifications posted %4$s (UI saw %5$s)</string>
    <string name="selftest_heartbeat" translatable="false">Heartbeat ticks %1$s, last gap %2$s ms, largest gap %3$s ms</string>
    <string name="selftest_app_state" translatable="false">Qt appState %1$s (Qt::ApplicationState; 1 = Hidden), service-ready handshake %2$s</string>
    <string name="selftest_fgs" translatable="false">FGS (type specialUse): %1$s</string>
    <string name="selftest_pids" translatable="false">PIDs: UI %1$s, engine %2$s; game: %3$s</string>
    <string name="selftest_link" translatable="false">Link: %1$s; attaches %2$s (last %3$s ms), engine losses %4$s (loss->attach %5$s ms), lines skipped %6$s</string>
    <string name="selftest_libmudlet" translatable="false">libmudlet: %1$s, start %2$s ms, loaded after %3$s ms; Lua files %4$s; local lines %5$s, error console %6$s; restore %7$s</string>
    <string name="selftest_last_error" translatable="false">Last error: %1$s</string>
    <string name="selftest_ping" translatable="false">Ping: %1$s</string>
    <string name="selftest_lua" translatable="false">Lua: %1$s</string>
    <string name="selftest_host" translatable="false">Host</string>
    <string name="selftest_port" translatable="false">Port</string>
    <string name="selftest_tls" translatable="false">TLS</string>
    <string name="selftest_connect" translatable="false">Connect</string>
    <string name="selftest_disconnect" translatable="false">Disconnect</string>
    <string name="selftest_show_debug" translatable="false">Debug</string>
    <string name="selftest_hide_debug" translatable="false">Hide debug</string>
    <string name="selftest_ping_many" translatable="false">Ping x300</string>
    <string name="selftest_kill_ui" translatable="false">Kill UI</string>
    <string name="selftest_kill_ui_process" translatable="false">Kill UI process</string>
    <string name="selftest_stop_engine" translatable="false">Stop engine</string>
    <string name="selftest_start_engine" translatable="false">Start engine</string>
    <string name="selftest_kill_engine_process" translatable="false">Kill engine process</string>
    <string name="selftest_qpa_next_start" translatable="false">QPA next start: %1$s</string>
    <string name="selftest_command" translatable="false">Command</string>
    <string name="selftest_command_hint" translatable="false">command, or: lua return lineCount</string>
    <string name="selftest_send" translatable="false">Send</string>
</resources>
