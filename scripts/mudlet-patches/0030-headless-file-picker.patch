+QString TNullAppFrontend::getOpenFileName(const QString& title, const QString& location)
+{
+    return mFilePicker ? mFilePicker(false, title, location) : QString();
+}
+
+QString TNullAppFrontend::getExistingDirectory(const QString& title, const QString& location)
+{
+    return mFilePicker ? mFilePicker(true, title, location) : QString();
+}
+
+void TNullAppFrontend::setFilePicker(std::function<QString(bool folder, const QString& title, const QString& location)> pick)
+{
+    mFilePicker = std::move(pick);
+}
