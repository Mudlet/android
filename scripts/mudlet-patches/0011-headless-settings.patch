+    void test_theInputLineSettingsAreKeptWithTheProfile()
+    {
+        const QString name = qsl("Headless Input Line");
+        QVERIFY(writeProfile(name, QString()));
+        const QStringList keys{qsl("commandSeparator"), qsl("highlightHistory"), qsl("disablePasswordMasking")};
+        const QVariantMap changed{{qsl("commandSeparator"), qsl("|")}, {qsl("highlightHistory"), false}, {qsl("disablePasswordMasking"), true}};
+        QVariantMap values;
+        QMap<QString, QString> refused;
+        {
+            THeadlessSession session;
+            QCOMPARE(session.start({.profile = name, .connect = false}), THeadlessSession::StartResult::started);
+            QVERIFY(session.settings(keys, values));
