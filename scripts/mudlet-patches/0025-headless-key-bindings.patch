+QList<QKeyCombination> THeadlessSession::keyBindings() const
+{
+    QList<QKeyCombination> result;
+    if (!mpHost) {
+        return result;
+    }
+    std::vector<int> combinations;
+    appendMatchedKeys(*mpHost, combinations);
+    std::sort(combinations.begin(), combinations.end());
+    combinations.erase(std::unique(combinations.begin(), combinations.end()), combinations.end());
+    const bool hiddenInput = mpHost->passwordEntryWanted();
+    for (const int combined : combinations) {
+        const QKeyCombination combination = QKeyCombination::fromCombined(combined);
+        if (bindingsOffered(*mpHost, combination, hiddenInput)) {
+            result.append(combination);
+        }
+    }
+    return result;
+}
+
+void THeadlessSession::noteKeyBindingsAtLoad()
+{
+    mKeyBindingsRun = mRun;
+    noteKeyBindingsState(*mpHost, mKeyBindingsMatched);
+    mKeyBindingsTold = keyBindings();
+}
+
+// A binding can change by a script, a package, the editor, a folder's switch or the emergency stop, and what is
+// offered by the game hiding input, none of which tells of it, so what they come to is compared instead
+void THeadlessSession::checkKeyBindings()
+{
+    if (true || mKeyBindingsRun != mRun || !mpHost || mpHost->closeStarted()) {
+        return;
+    }
+    noteKeyBindingsState(*mpHost, mKeyBindingsMatchedNow);
+    if (mKeyBindingsMatchedNow == mKeyBindingsMatched) {
+        return;
+    }
+    std::swap(mKeyBindingsMatched, mKeyBindingsMatchedNow);
+    QList<QKeyCombination> bindings = keyBindings();
+    if (bindings == mKeyBindingsTold) {
+        return;
+    }
+    mKeyBindingsTold = std::move(bindings);
+    // Not as the loop is about to wait, which a handler that runs the event loop would make re-entrant
+    QMetaObject::invokeMethod(
+            this,
+            [this, run = mRun]() {
+                if (run == mRun) {
+                    const QString profile = mProfileName;
+                    emit keyBindingsChanged(profile);
+                }
+            },
+            Qt::QueuedConnection);
+}
