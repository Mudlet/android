+-- The compact layout, for a main window with a compact width or height: no dock
+-- and no map, since the frontend's own map is the one that fits a screen that
+-- size, only the bars along the top and a button for each chat tab along the
+-- bottom. A button opens its tab over the game's text and closes it again, the
+-- way Mudlet Web's phone layout switches between its panels from a row of buttons
+-- under them. Sizes are in the main window's logical pixels, getMainWindowInfo()'s
+-- pixelScale Mudlet pixels each, so a button is as big under a finger on a dense
+-- phone screen as it is on a desktop. The buttons are 48 tall, the smallest touch
+-- target Android's accessibility guidelines allow, as a frontend that grows a
+-- smaller one to that is stopped by an open tab right above it.
+local compact = {
+  barHeight = 26, barPadding = 3, barGap = 6,
+  buttonHeight = 48, rowPadding = 4, buttonGap = 4,
+}
+
+-- Locked, and attached to its border, so the console gives it room the way it
+-- gives the dock room and other scripts' containers on that border share it
+local function compactStrip(name, border, style)
+  local strip = Adjustable.Container:new({
+    name = name,
+    x = "0%", y = border == "top" and "0%" or "-1", width = "100%", height = 1,
+    attached = border,
+    attachedMargin = 0,
+    padding = 0,
+    autoLoad = false,
+    autoSave = false,
+  })
+  -- not locked by the constructor: it locks before attaching, and locking reserves
+  -- the border from a list of that border's containers made only on attaching
+  strip:lockContainer("full")
+  -- a right-click would open Adjustable's menu, whose items unlock, move and close it
+  strip.adjLabel:setClickCallback(function() end)
+  -- that callback would have a screen reader call the strip a button
+  strip.adjLabel:setAccessibleRole("text")
+  -- set after locking: the "full" lock style zeroes every border width
+  strip.adjLabelstyle = style
+  strip.adjLabel:setStyleSheet(style)
+  return strip
+end
+
+local function createCompactWidgets()
+  BaseUI.vitalsBar = compactStrip("BaseUI_vitals_bar", "top", css.vitalsBar)
+  BaseUI.chatButtonRow = compactStrip("BaseUI_chat_buttons", "bottom", css.chatButtonRow)
+  BaseUI.chatSheet = Geyser.Container:new({
+    name = "BaseUI_chat_sheet",
+    x = 0, y = 0, width = 1, height = 1,
+  })
+  BaseUI.chatButtons = {}
+  BaseUI.buttonPainted = {}
+  for _, tab in ipairs(chatTabs) do
+    local button = Geyser.Label:new({
+      name = "BaseUI_chat_button_" .. tab.key,
+      x = 0, y = 0, width = 1, height = 1,
+      font = theme.font, fontSize = 10, format = "c",
+    }, BaseUI.chatButtonRow.Inside)
+    button:setClickCallback(BaseUI.toggleChat, tab.key)
+    BaseUI.chatButtons[tab.key] = button
+  end
+end
+
+-- Geyser keeps a strip's height and its distance from the edge as separate
+-- constraints, so both change together, as fitDockWidth does for the dock
+local function sizeStrip(strip, border, height)
+  if strip.height == height then
+    return
+  end
+  strip.height = height
+  if border == "bottom" then
+    strip.y = "-" .. height
+  end
+  strip:set_constraints(strip)
+  strip:adjustBorder()
+end
+
+-- A widget the hidden dock hid along with itself comes out hidden by its parent;
+-- show(true) clears just that, so a bar or a pane hidden on purpose stays hidden
+local function moveInto(widget, container)
+  if widget.container ~= container then
+    widget:changeContainer(container)
+    widget:show(true)
+  end
+end
+
+-- Two bars to a row with the window upright and all of them in one row on its side,
+-- in vitalsStats order like the dock's
+local function layoutVitalsBar(scale, upright)
+  local bar, slots = BaseUI.vitalsBar, BaseUI.usedGaugeSlots
+  if slots == 0 then
+    bar:hide()
+    return
+  end
+  bar:show()
+  local columns = math.min(slots, upright and 2 or maxGaugeSlots)
+  local padding, gap = compact.barPadding * scale, compact.barGap * scale
+  local height = compact.barHeight * scale
+  sizeStrip(bar, "top", math.floor(math.ceil(slots / columns) * height + 2 * padding))
+  local width = (bar:get_width() - 2 * padding - (columns - 1) * gap) / columns
+  local index = 0
+  for _, stat in ipairs(vitalsStats) do
+    local gauge = BaseUI.gauges[stat.key]
+    if gauge then
+      moveInto(gauge, bar.Inside)
+      local column, row = index % columns, math.floor(index / columns)
+      gauge:move(math.floor(padding + column * (width + gap)), math.floor(padding + row * height))
+      gauge:resize(math.floor(width), math.floor(height))
+      index = index + 1
+    end
+  end
+end
+
+local function layoutChatButtons(scale)
+  local row = BaseUI.chatButtonRow
+  row:show()
+  local padding, gap = math.floor(compact.rowPadding * scale), compact.buttonGap * scale
+  -- Rounded up: rounded down, a button falls short of the touch target it is sized to
+  local height = math.ceil(compact.buttonHeight * scale)
+  sizeStrip(row, "bottom", height + 2 * padding)
+  local width = (row:get_width() - 2 * padding - (#chatTabs - 1) * gap) / #chatTabs
+  for i, tab in ipairs(chatTabs) do
+    local button = BaseUI.chatButtons[tab.key]
+    button:move(math.floor(padding + (i - 1) * (width + gap)), padding)
+    button:resize(math.floor(width), height)
+  end
+end
+
+-- An open tab covers the console exactly, between the bars and the buttons
+local function layoutChatSheet(entering)
+  local sheet = BaseUI.chatSheet
+  local windowWidth, windowHeight = getMainWindowSize()
+  local left, top = getBorderLeft(), getBorderTop()
+  sheet:move(left, top)
+  sheet:resize(math.max(0, windowWidth - left - getBorderRight()), math.max(0, windowHeight - top - getBorderBottom()))
+  sheet:show()
+  for _, tab in ipairs(chatTabs) do
+    local pane = BaseUI.chats[tab.key]
+    if entering then
+      pane:hide()
+    end
+    if pane.container ~= sheet then
+      moveInto(pane, sheet)
+      pane:move("0%", "0%")
+      pane:resize("100%", "100%")
+    end
+  end
+end
+
+-- The dock and the chat panes are made whatever the layout, so changing layouts is
+-- moving the bars and the panes between the two and showing one of them
+local function arrangeCompact()
+  local entering = not BaseUI.laidOutCompact
+  BaseUI.laidOutCompact = true
+  if not BaseUI.container.hidden then
+    BaseUI.container:hide()
+  end
+  -- a section dragged out of the dock is no longer its child to hide
+  for _, key in ipairs(sectionOrder) do
+    local section = BaseUI.sections[key]
+    if section and BaseUI.sectionFloating(key) and not section.hidden then
+      section:hide()
+    end
+  end
+  if BaseUI.dormant() then
+    for _, widget in ipairs({ BaseUI.vitalsBar, BaseUI.chatButtonRow, BaseUI.chatSheet }) do
+      widget:hide()
+    end
+    return
+  end
+  if not BaseUI.vitalsBar then
+    createCompactWidgets()
+  end
+  if entering then
+    BaseUI.openChat = nil
+  end
+  local info = mainWindowInfo()
+  local scale = tonumber(info and info.pixelScale) or 1
+  layoutVitalsBar(scale, info and info.widthClass == "compact")
+  layoutChatButtons(scale)
+  -- last: it covers whatever the two strips leave of the console
+  layoutChatSheet(entering)
+  BaseUI.paintChatButtons()
+  refitChatWelcome()
+end
+
+function BaseUI.layoutCompact()
+  -- the first fit comes while build() is still making them; and the strips resize
+  -- the console, whose resize event comes back here before they are all placed
+  if not BaseUI.chats or not BaseUI.sections.vitals or BaseUI.arrangingCompact then
+    return
+  end
+  BaseUI.arrangingCompact = true
+  local ok, problem = pcall(arrangeCompact)
+  BaseUI.arrangingCompact = false
+  if not ok then
+    error(problem)
+  end
+end
+
+-- Puts the bars and the panes back in the dock and shows it, and says whether
+-- there was anything to put back
+function BaseUI.leaveCompact()
+  if not BaseUI.laidOutCompact then
+    return false
+  end
+  BaseUI.laidOutCompact = false
+  BaseUI.openChat = nil
+  for _, gauge in pairs(BaseUI.gauges) do
+    gauge:changeContainer(BaseUI.sections.vitals)
+  end
+  local belowTabs = layout.tabs + layout.tabGap
+  for _, tab in ipairs(chatTabs) do
+    local pane = BaseUI.chats[tab.key]
+    pane:changeContainer(BaseUI.sections.chat)
+    pane:move("0%", belowTabs)
+    pane:resize("100%", "100%-" .. belowTabs)
+  end
+  if BaseUI.vitalsBar then
+    BaseUI.vitalsBar:hide()
+    BaseUI.chatButtonRow:hide()
+    BaseUI.chatSheet:hide()
+  end
+  if not BaseUI.dormant() then
+    BaseUI.container:show()
+  end
+  BaseUI.selectChatTab(BaseUI.activeChatTab)
+  refitChatWelcome()
+  return true
+end
+
+-- Opens a tab over the game's text, or closes it if it is the one open
+function BaseUI.toggleChat(key)
+  if not BaseUI.chats or not BaseUI.chats[key] then
+    return
+  end
+  if BaseUI.openChat == key then
+    BaseUI.openChat = nil
+    BaseUI.chats[key]:hide()
+    BaseUI.paintChatButtons()
+    return
+  end
+  BaseUI.openChat = key
+  BaseUI.selectChatTab(key)
+end
+
+-- Each button says what is behind it, and a screen reader says whether it is open.
+-- Compared against what was last painted, for the reason refreshChatTabs compares:
+-- a captured chat line moves one count.
+function BaseUI.paintChatButtons()
+  if not BaseUI.chatButtons then
+    return
+  end
+  for _, tab in ipairs(chatTabs) do
+    local button = BaseUI.chatButtons[tab.key]
+    local open = BaseUI.openChat == tab.key
+    local unread = open and 0 or math.min(BaseUI.unread[tab.key] or 0, 99)
+    local text = unread &gt; 0 and string.format("%s (%d)", tab.label, unread) or tab.label
+    local style = open and css.chatButtonOpen or css.chatButton
+    local painted = BaseUI.buttonPainted[tab.key]
+    if not painted or painted.text ~= text or painted.style ~= style then
+      button:setStyleSheet(style)
+      button:echo(text, open and theme.bg or theme.textDim)
+      button:setAccessibleName(string.format("%s chat%s%s", tab.label,
+        unread &gt; 0 and string.format(", %d new", unread) or "", open and ", open" or ""))
+      BaseUI.buttonPainted[tab.key] = { text = text, style = style }
+    end
+  end
+end
+
+function BaseUI.restyleCompact()
+  if not BaseUI.vitalsBar then
+    return
+  end
+  BaseUI.vitalsBar.adjLabelstyle = css.vitalsBar
+  BaseUI.vitalsBar.adjLabel:setStyleSheet(css.vitalsBar)
+  BaseUI.chatButtonRow.adjLabelstyle = css.chatButtonRow
+  BaseUI.chatButtonRow.adjLabel:setStyleSheet(css.chatButtonRow)
+  for _, button in pairs(BaseUI.chatButtons) do
+    button:setFont(theme.font)
+  end
+  -- the font change re-echoes in the colour the label had
+  BaseUI.buttonPainted = {}
+  BaseUI.paintChatButtons()
