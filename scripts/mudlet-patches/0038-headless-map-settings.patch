+            {u"mapAnsiLightCyan", &Host::mLightCyan_2},
+            {u"mapAnsiLightWhite", &Host::mLightWhite_2},
+    }};
+    for (const auto& [name, member] : members) {
+        if (name == key) {
+            return member;
