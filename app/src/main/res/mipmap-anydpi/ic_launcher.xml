<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon: Mudlet's arch on a background, and a silhouette of it that Android 13's themed icons tint.
     Each release channel has its own layers, in src/<channel>/res (app/build.gradle.kts); docs/launcher-icon.md. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
