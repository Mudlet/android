<?xml version="1.0" encoding="utf-8"?>
<!-- Android lint for :app and :engine-service (lintConfig in their build.gradle.kts), where a warning fails the build.
     Each check turned off here says why. -->
<lint>
    <!-- Versions are Dependabot's and the pin policy's (CONTRIBUTING.md, "Pinned versions"); these checks change
         their verdict with each day's releases, so they would fail a build that changed nothing -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="OldTargetApi" severity="ignore" />
    <!-- Each debug APK, which is what lint looks at, is built for one ABI on purpose (-PandroidAbi; x86_64 for the
         emulator). The release has x86_64 as well as arm64-v8a (scripts/build-release.sh, docs/ptb.md) -->
    <issue id="ChromeOsAbiSupport" severity="ignore" />
    <!-- Translations come from Crowdin as translators finish them (docs/translations.md); a string not yet translated
         shows in English, as in Mudlet's desktop app -->
    <issue id="MissingTranslation" severity="ignore" />
    <!-- A string the English has dropped stays in each translation until Crowdin's next pull request: on, these would
         fail every build of main in between -->
    <issue id="ExtraTranslation" severity="ignore" />
    <issue id="UnusedResources">
        <ignore path="**/values-*/strings.xml" />
    </issue>
    <!-- Checks of the English's wording and plural forms, which a translation follows its own language's rules for:
         lint's dictionaries and CLDR's plural forms are not Crowdin's, and a plural form missing falls back to "other".
         The checks of placeholders (StringFormat*, ImpliedQuantity) stay on: a wrong one crashes or misleads -->
    <issue id="Typos">
        <ignore path="**/values-*/strings.xml" />
    </issue>
    <issue id="TypographyDashes">
        <ignore path="**/values-*/strings.xml" />
    </issue>
    <issue id="TypographyEllipsis">
        <ignore path="**/values-*/strings.xml" />
    </issue>
    <issue id="TypographyFractions">
        <ignore path="**/values-*/strings.xml" />
    </issue>
    <issue id="TypographyOther">
        <ignore path="**/values-*/strings.xml" />
    </issue>
    <issue id="MissingQuantity">
        <ignore path="**/values-*/strings.xml" />
    </issue>
    <issue id="UnusedQuantity">
        <ignore path="**/values-*/strings.xml" />
    </issue>
    <!-- Advice on a folder's language code: Crowdin names the folders with its Android codes (values-iw-rIL for Hebrew),
         which Android reads -->
    <issue id="LocaleFolder" severity="ignore" />
    <!-- AppLanguage changes the locale itself only before Android 13, and the app's bundle keeps every language in its
         base APK (bundle.language.enableSplit in app/build.gradle.kts), which this check cannot see from
         :engine-service -->
    <issue id="AppBundleLocaleChanges">
        <ignore path="**/AppLanguage.kt" />
    </issue>
</lint>
