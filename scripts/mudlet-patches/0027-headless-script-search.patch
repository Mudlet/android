diff --git a/src/headless/THeadlessSessionScripts.cpp b/src/headless/THeadlessSessionScripts.cpp
index ec97746..28ee237 100644
--- a/src/headless/THeadlessSessionScripts.cpp
+++ b/src/headless/THeadlessSessionScripts.cpp
@@ -811,6 +811,165 @@ QList<THeadlessSession::ScriptItemNode> THeadlessSession::scriptItems(const Scri
 
 namespace {
 
+using Field = THeadlessSession::ScriptSearchField;
+
+// What the editor's search finds, as dlgTriggerEditor::findSearchMatch() finds it
+class ScriptSearch
+{
+public:
+    ScriptSearch(const QString& text, const bool caseSensitive, const bool wholeWord, const int limit)
+    : mText(text)
+    , mCase(caseSensitive ? Qt::CaseSensitive : Qt::CaseInsensitive)
+    , mLimit(limit)
+    {
+        if (wholeWord) {
+            mWord = QRegularExpression(qsl("\\b%1\\b").arg(QRegularExpression::escape(text)), caseSensitive ? QRegularExpression::NoPatternOption : QRegularExpression::CaseInsensitiveOption);
+        }
+    }
+
+    template <class T>
+    void searchShown(Host& host, const Kind kind)
+    {
+        for (T* pItem : rootItems<T>(host)) {
+            searchTree(host, kind, pItem);
+        }
+    }
+
+    QList<THeadlessSession::ScriptSearchMatch> mMatches;
+    bool mMore = false;
+
+private:
+    template <class T>
+    void searchTree(Host& host, const Kind kind, T* pItem)
+    {
+        if (mMore || !shown(host, pItem)) {
+            return;
+        }
+        mKind = kind;
+        mId = pItem->getID();
+        mName = pItem->getName();
+        once(Field::name, mName);
+        searchFields(pItem);
+        lines(Field::lua, pItem->getScript());
+        for (auto* pChild : *pItem->getChildrenList()) {
+            searchTree(host, kind, static_cast<T*>(pChild));
+        }
+    }
+
+    void searchFields(TTrigger* pItem)
+    {
+        once(Field::command, pItem->getCommand());
+        const QStringList& patterns = pItem->getPatternsList();
+        for (int i = 0; i < patterns.size(); ++i) {
+            every(Field::pattern, i, patterns.at(i));
+        }
+    }
+
+    void searchFields(TAlias* pItem)
+    {
+        once(Field::command, pItem->getCommand());
+        once(Field::pattern, pItem->getRegexCode());
+    }
+
+    void searchFields(TScript* pItem)
+    {
+        const QStringList handlers = pItem->getEventHandlerList();
+        for (int i = 0; i < handlers.size(); ++i) {
+            every(Field::event, i, handlers.at(i));
+        }
+    }
+
+    void searchFields(TTimer* pItem) { once(Field::command, pItem->getCommand()); }
+
+    void searchFields(TKey* pItem) { once(Field::command, pItem->getCommand()); }
+
+    void searchFields(TAction* pItem)
+    {
+        once(pItem->isPushDownButton() ? Field::commandDown : Field::command, pItem->getCommandButtonDown());
+        if (pItem->isPushDownButton()) {
+            once(Field::commandUp, pItem->getCommandButtonUp());
+        }
+        lines(Field::css, pItem->css);
+    }
+
+    int find(const QString& haystack, const int from) const
+    {
+        if (mText.isEmpty()) {
+            return -1;
+        }
+        if (mWord.pattern().isEmpty()) {
+            return haystack.indexOf(mText, from, mCase);
+        }
+        const QRegularExpressionMatch match = mWord.match(haystack, from);
+        return match.hasMatch() ? match.capturedStart() : -1;
+    }
+
+    void add(const Field field, const int index, const QString& text, const int start)
+    {
+        if (mMatches.size() >= mLimit) {
+            mMore = true;
+            return;
+        }
+        mMatches.append({mKind, mId, mName, field, index, text, start});
+    }
+
+    // The editor gives a name, a command and an alias's pattern one result, however often the text is in it
+    void once(const Field field, const QString& text)
+    {
+        if (const int start = find(text, 0); start != -1) {
+            add(field, 0, text, start);
+        }
+    }
+
+    void every(const Field field, const int index, const QString& text)
+    {
+        for (int start = find(text, 0); start != -1 && !mMore; start = find(text, start + 1)) {
+            add(field, index, text, start);
+        }
+    }
+
+    void lines(const Field field, const QString& text)
+    {
+        // Most Lua holds no match, and splitting it into lines costs more than one look at it whole
+        if (find(text, 0) == -1) {
+            return;
+        }
+        const QStringList textLines = text.split(QLatin1Char('\n'));
+        for (int i = 0; i < textLines.size() && !mMore; ++i) {
+            every(field, i, textLines.at(i));
+        }
+    }
+
+    const QString mText;
+    const Qt::CaseSensitivity mCase;
+    const int mLimit;
+    QRegularExpression mWord;
+    Kind mKind = Kind::trigger;
+    int mId = 0;
+    QString mName;
+};
+
+} // namespace
+
+QList<THeadlessSession::ScriptSearchMatch> THeadlessSession::searchScriptItems(const QString& text, const bool caseSensitive, const bool wholeWord, const int limit, bool& more) const
+{
+    more = false;
+    if (!mpHost) {
+        return {};
+    }
+    ScriptSearch search(text, caseSensitive, wholeWord, limit);
+    search.searchShown<TTrigger>(*mpHost, Kind::trigger);
+    search.searchShown<TAlias>(*mpHost, Kind::alias);
+    search.searchShown<TScript>(*mpHost, Kind::script);
+    search.searchShown<TAction>(*mpHost, Kind::button);
+    search.searchShown<TTimer>(*mpHost, Kind::timer);
+    search.searchShown<TKey>(*mpHost, Kind::key);
+    more = search.mMore;
+    return search.mMatches;
+}
+
+namespace {
+
 // The calls below each take the item's own class, so they dispatch on kind once, here
 template <class Call>
 auto withItemClass(const Kind kind, Call&& call)
