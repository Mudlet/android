index cc90f8deb..ec601b47f 100644
--- a/src/mudlet-lua/tests/UI_spec.lua
+++ b/src/mudlet-lua/tests/UI_spec.lua
@@ -3431,9 +3431,9 @@ describe("Tests UI functions", function()
         BaseUI.layoutDock()
       end
       savedWidth, savedX, savedY = BaseUI.container.width, BaseUI.container.x, BaseUI.container.y
