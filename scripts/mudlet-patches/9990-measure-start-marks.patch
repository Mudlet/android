diff --git a/src/StartMark.h b/src/StartMark.h
new file mode 100644
index 000000000..307f1d016
--- /dev/null
+++ b/src/StartMark.h
@@ -0,0 +1,13 @@
+#pragma once
+// Measure only (Mudlet/android's perf-engine-measure branch): a CLOCK_BOOTTIME stamp on the log, to line up with
+// SystemClock.elapsedRealtime() in the app's processes
+#include <QtGlobal>
+#include <ctime>
+
+inline void startMark(const char* what)
+{
+    timespec ts{};
+    clock_gettime(CLOCK_BOOTTIME, &ts);
+    const long long us = static_cast<long long>(ts.tv_sec) * 1000000 + ts.tv_nsec / 1000;
+    qInfo("MUDLET_T %s %lld.%03lld", what, us / 1000, us % 1000);
+}
