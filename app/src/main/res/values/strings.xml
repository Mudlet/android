    <string name="profile_login">Character name</string>
    <string name="profile_password">Password</string>
    <string name="profile_password_stored">A password is stored. Type a new one to replace it.</string>
    <string name="profile_password_forget">Forget password</string>
    <string name="profile_password_not_stored">The game was saved, but its password could not be stored.</string>
    <string name="profile_password_not_forgotten">The password could not be forgotten.</string>
    <string name="profile_auto_reconnect">Reconnect automatically</string>
    <string name="profile_save">Save</string>
    <string name="profile_delete">Delete</string>
    <!-- The title of the dialog that confirms deleting a profile; %1$s is its name -->
    <string name="profile_delete_title">Delete %1$s?</string>
    <string name="profile_delete_text">Its settings, scripts and everything else Mudlet keeps for it on this device are deleted too.</string>
    <string name="profile_delete_cancel">Cancel</string>

    <!-- The game screen's title: the screen with the game's text, the command line and the connection bar -->
    <string name="game_title">Game</string>

    <!-- The About screen, opened from the profile list's top bar: the app's version, its engine, where their source
         code is, and the licences of everything the app contains. Also the top bar button's label for TalkBack. -->
    <string name="about_title">About and licences</string>
    <!-- %1$s is the app's version name (such as 5.1.0-ptb-2026-11-14-…), %2$d its version code, a number -->
    <string name="about_version">Version %1$s (%2$d)</string>
    <!-- %1$s is Mudlet's version, such as 5.1.0-dev-1a2b3c4 -->
    <string name="about_engine_mudlet">Engine: Mudlet %1$s</string>
    <!-- %1$s is the start of the git commit (a hexadecimal identifier) of Mudlet's source code the engine was built from -->
    <string name="about_engine_commit">Built from Mudlet commit %1$s</string>
    <string name="about_engine_commit_unknown">Built from a Mudlet source tree whose commit is not known</string>
    <!-- Developer builds carry a small engine of the app's own instead of Mudlet -->
    <string name="about_engine_standin">Engine: the stand-in engine of developer builds, not Mudlet</string>
    <string name="about_free_software_heading">Free software</string>
    <!-- The GNU General Public License (GPL) is the licence's name: keep it recognisable, and the version numbers as they are -->
    <string name="about_free_software">Mudlet is free software under the GNU General Public License, version 2 or later. Built together with Qt and OpenSSL, this app as a whole is distributed under version 3 of the GNU GPL: you may share and change it under its terms. It comes with no warranty.</string>
    <!-- A button that opens the source code of this Android app in the browser -->
    <string name="about_source_app">Source code of this app</string>
    <!-- A button that opens, in the browser, the source code of the exact Mudlet the engine was built from -->
    <string name="about_source_mudlet">Source code of this Mudlet</string>
    <!-- The GNU Lesser General Public License (LGPL) is the licence's name -->
    <string name="about_qt_notice">Qt is used under the GNU Lesser General Public License, version 3, as libraries of its own. You can get Qt\'s source code, and rebuild this app with a Qt you have changed.</string>
    <!-- A button that opens the download page of Qt's source code; %1$s is Qt's version, such as 6.12.0 -->
    <string name="about_qt_source">Source code of Qt %1$s</string>
    <!-- A button that opens the instructions for rebuilding the app with a changed Qt -->
    <string name="about_qt_relink">How to rebuild the app with your own Qt</string>
    <string name="about_licences_heading">Licences</string>
    <!-- Headings of the licence list -->
    <string name="about_group_app">This app, Mudlet and Qt</string>
    <string name="about_group_native">Libraries, fonts and icons built in</string>
    <string name="about_group_qt">Code from others inside Qt</string>
    <string name="about_group_android">Android libraries</string>
    <!-- A row of the licence list: %1$s is the version, %2$s the licence's SPDX identifier, such as MIT -->
    <string name="about_component_version_licence">%1$s · %2$s</string>
    <!-- What TalkBack says tapping a row of the licence list does: "Double tap to read its licence" -->
    <string name="about_open_licence">read its licence</string>
    <!-- On a wide screen, where a component's licence opens beside the licence list: what that space shows until one is picked -->
    <string name="about_pick">Pick a component to read its licence.</string>
    <string name="about_loading">Loading…</string>
    <!-- %1$s is the error, in English -->
    <string name="about_load_failed">The licence list could not be read: %1$s</string>
    <!-- Shown when a link cannot be opened; %1$s is the web address -->
    <string name="about_no_browser">No app here can open %1$s</string>

    <!-- The screen of one component of the licence list: its version, licence and copyright, then the licence texts -->
    <!-- %1$s is the component's version -->
    <string name="licence_version">Version %1$s</string>
    <!-- %1$s is the licence as an SPDX expression, such as "MIT" or "Apache-2.0 WITH LLVM-exception" -->
    <string name="licence_licence">Licence: %1$s</string>
    <!-- A button that opens the component's website -->
    <string name="licence_website">Website</string>
    <!-- A button that opens where the component's source code is -->
    <string name="licence_source">Source code</string>
    <!-- The heading above a licence's full text; %1$s is its SPDX identifier, such as GPL-3.0-only -->
    <string name="licence_text_heading">Licence text: %1$s</string>
    <!-- %1$s is the licence's SPDX identifier -->
    <string name="licence_text_missing">The text of %1$s is missing from this app.</string>
    <!-- %1$s is the component's internal identifier -->
    <string name="licence_not_found">No component %1$s in the licence list.</string>

    <!-- The settings screen, reached from the title bar of the profile list and of the game screen -->
    <string name="settings_title">Settings</string>
    <string name="settings_text_size">Text size</string>
    <string name="settings_text_size_hint">The size of the game\'s text. Pinching the text with two fingers changes it too, and the system\'s font size scales it.</string>
    <!-- %1$d is the text size, a whole number (in sp, which players need not know) -->
    <string name="settings_text_size_value">Size %1$d</string>
    <string name="settings_text_smaller">Smaller text</string>
    <string name="settings_text_larger">Larger text</string>
    <!-- A line of the kind a game sends, to show the text size -->
    <string name="settings_text_size_sample">You see a brass lantern here.</string>
    <string name="settings_screen_reader">Screen reader</string>
    <string name="settings_read_new_text">Read new text aloud</string>
    <string name="settings_read_new_text_hint">While TalkBack is on, the game\'s new text is read out as it arrives.</string>
    <string name="settings_advertise_screen_reader">Tell games I use a screen reader</string>
    <string name="settings_advertise_screen_reader_hint">Games that ask are told, and some then send text laid out for screen readers.</string>
    <!-- The settings screen's map section: whether the game's map is drawn faintly behind the game's text. The map
         button above the game's text brings it to the front either way. -->
    <string name="settings_map">Map</string>
    <string name="settings_map_behind_text">Map behind the text</string>
    <string name="settings_map_behind_text_hint">The game\'s map shows faintly behind the game\'s text, following you. The map button brings it to the front.</string>
    <!-- The heading of three choices: what becomes of the empty lines a game sends -->
    <string name="settings_blank_lines">Blank lines from the game</string>
    <string name="settings_blank_lines_show">Show them</string>
    <string name="settings_blank_lines_hide">Hide them</string>
    <string name="settings_blank_lines_space">Replace them with a space</string>
    <!-- The settings screen's section on how the app looks. On Android 12 and later only, which can colour apps
         from the wallpaper (Material You); the game's own colours never change with it. -->
    <string name="settings_appearance">Appearance</string>
    <!-- The switch in the Appearance section: on, the app's screens take their colours from the wallpaper -->
    <string name="settings_wallpaper_colours">Colours from my wallpaper</string>
    <!-- Under "Colours from my wallpaper", what the switch does -->
    <string name="settings_wallpaper_colours_hint">The app\'s screens take their colours from your wallpaper. Off, they use Mudlet\'s own. The game\'s text keeps the game\'s colours.</string>

    <!-- Asked once, the first time the app runs with TalkBack on -->
    <string name="screen_reader_offer_title">Tell games you use a screen reader?</string>
    <string name="screen_reader_offer_text">Games that ask are told, and some then send text laid out for screen readers. You can change this in the settings.</string>
    <string name="screen_reader_offer_yes">Tell games</string>
    <string name="screen_reader_offer_no">Don\'t tell</string>

    <!-- What TalkBack says for many game lines that came at once: %1$d is how many, %2$s the last few of them -->
    <plurals name="announce_burst">
        <item quantity="one">%1$d new line: %2$s</item>
        <item quantity="other">%1$d new lines, ending: %2$s</item>
    </plurals>

    <!-- The game screen's console: the button back to the newest text, shown while the player is scrolled up -->
    <string name="console_jump_to_bottom">Jump to the bottom</string>
    <!-- The same button once new lines came in while the player was scrolled up; %1$d is how many -->
    <plurals name="console_jump_new_lines">
        <item quantity="one">Jump to the bottom: %1$d new line</item>
        <item quantity="other">Jump to the bottom: %1$d new lines</item>
    </plurals>

    <!-- The game screen's input line, where the player types commands for the game -->
    <string name="input_label">Command</string>
    <!-- The input line's button that sends the typed command to the game, read by a screen reader -->
    <string name="input_send">Send</string>
    <!-- The input line's up-arrow button, read by a screen reader: it puts the command typed before into the input
         line -->
    <string name="input_history_previous">Previous command</string>
    <!-- The input line's down-arrow button, read by a screen reader: it goes forward again through the commands typed
         before -->
    <string name="input_history_next">Next command</string>
    <!-- Shown under the input line when a command could not be sent; the engine is the part of the app that runs the
         game's connection -->
    <string name="input_not_sent">Not sent: the app is not connected to the engine</string>
    <!-- The button, also the Tab key, that completes the word being typed from the words the game sent -->
    <string name="input_complete">Complete the word</string>
    <!-- Shown under the input line when no word the game sent starts with what the player typed -->
    <string name="input_no_completion">No completion</string>
    <!-- The masked field that takes the input line's place while the game asks for a password -->
    <string name="input_password_label">Password</string>
    <!-- The button, read by a screen reader, that closes the password field and brings the input line back -->
    <string name="input_password_close">Close the password field</string>
    <!-- A button above the input line that puts a suggested command, or word, on the line without sending it; %1$s is
         the command or word -->
    <string name="input_suggestion">Suggestion: %1$s</string>
    <!-- The button, also the right arrow key at the end of the line, that completes the line with the suggestion shown
         greyed after it; %1$s is the whole line it gives -->
    <string name="input_accept_suggestion">Accept the suggestion: %1$s</string>

