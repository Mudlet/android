+void TLabelModel::setLiveRegion(TLabelLiveRegion liveRegion)
+{
+    if (mLiveRegion == liveRegion) {
+        return;
+    }
+    mLiveRegion = liveRegion;
+    accessibilityChanged(AccessibilityChange::LiveRegion);
+}
