<?xml version="1.0" encoding="utf-8"?>
<!-- The strings the app shows, translated on Crowdin (docs/translations.md): each translatable one has a comment for
     translators right before it. app_name comes from app/build.gradle.kts (resValue), as the PTB has a name of its own. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The arrow button at the start of a screen's title bar, read by a screen reader: it goes back to the screen
         before -->
    <string name="navigate_back">Back</string>
    <!-- On a wide screen, a profile's editor or a licence opens beside its list: the button at its top that closes
         it, read by TalkBack. %1$s is what it shows, as its title says: a game's name, say, or "New game" -->
    <string name="detail_close">Close %1$s</string>

    <!-- Shown before Android's own notification permission prompt, to say what the notifications are for -->
    <string name="notifications_explanation_title">Allow notifications?</string>
    <string name="notifications_explanation_text">While you use other apps, Mudlet keeps your game connected and your scripts running, and shows a notification you can quit it from. Your scripts can also notify you, for example of a tell.</string>
    <string name="notifications_explanation_continue">Continue</string>
    <string name="notifications_explanation_not_now">Not now</string>

    <!-- The start screen's title: the list of the player's games (in Mudlet, a profile is a game and its settings) -->
    <string name="profiles_title">Profiles</string>
    <!-- On a wide screen, where a game's editor opens beside the list of games: what that space shows until one is picked -->
    <string name="profiles_pick">Pick a game to edit it, or add one.</string>
    <string name="profiles_waiting">Waiting for the engine…</string>
    <string name="profiles_empty">No games yet. Add one with its address.</string>
    <string name="profiles_add">Add a game</string>
    <!-- What TalkBack reads for a profile in the list: its name, then its address as host:port -->
    <string name="profile_description">%1$s, %2$s:%3$d</string>
    <string name="profile_address">%1$s:%2$d</string>
    <string name="profile_connect">Connect</string>
    <!-- TalkBack's label for a profile's Connect button; %1$s is the profile's name -->
    <string name="profile_connect_to">Connect to %1$s</string>
    <!-- TalkBack's label for a profile's edit button; %1$s is the profile's name -->
    <string name="profile_edit">Edit %1$s</string>
    <!-- Why a profile request got no answer. The engine gives its own reasons, in English, for those it refuses -->
    <string name="profiles_error_not_attached">The engine is not running yet. Try again in a moment.</string>
    <string name="profiles_error_engine_lost">The engine stopped before it answered. Try again.</string>

    <string name="profile_new_title">New game</string>
    <string name="profile_name">Name</string>
    <string name="profile_host">Host</string>
    <string name="profile_port">Port</string>
