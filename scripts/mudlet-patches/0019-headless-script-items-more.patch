+
+void switchItem(TTimer* pItem, const bool enabled)
+{
+    const bool offset = pItem->isOffsetTimer();
+    if (offset) {
+        pItem->setShouldBeActive(enabled);
+    } else {
+        pItem->setIsActive(enabled);
+    }
+    if (!enabled) {
+        pItem->disableTimer(pItem->getID());
+        return;
+    }
+    pItem->enableTimer(pItem->getID());
+    if (offset) {
+        // The timer it is in arms it as it fires, so it must not count down from being switched on
+        pItem->stop();
+    }
+}
