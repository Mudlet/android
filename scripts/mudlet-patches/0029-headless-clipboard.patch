+QString TNullAppFrontend::clipboardText()
+{
+    if (mClipboardRead) {
+        return mClipboardRead();
+    }
+    return qobject_cast<QGuiApplication*>(QCoreApplication::instance()) ? QGuiApplication::clipboard()->text() : mClipboardText;
+}
+
 void TNullAppFrontend::setClipboardText(const QString& text)
 {
+    if (mClipboardWrite) {
+        mClipboardWrite(text);
+        return;
+    }
     if (qobject_cast<QGuiApplication*>(QCoreApplication::instance())) {
         QGuiApplication::clipboard()->setText(text);
         return;
@@ -209,6 +221,16 @@ void TNullAppFrontend::setClipboardText(const QString& text)
     mClipboardText = text;
 }
 
+void TNullAppFrontend::setClipboard(std::function<QString()> read, std::function<void(const QString&)> write)
+{
+    if (!read || !write) {
+        read = nullptr;
+        write = nullptr;
+    }
+    mClipboardRead = std::move(read);
+    mClipboardWrite = std::move(write);
+}
