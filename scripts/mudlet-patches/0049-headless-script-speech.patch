+// Gives text to setScriptSpeech()'s speaker, if there is one and it takes it.
+static bool handOverSpeech(const QString& text)
+{
+    if (!speechElsewhere || !speechElsewhere(text)) {
+        return false;
+    }
+    speechHandedOver = true;
+    speechCurrent = text;
+    speechStartAnnounced = true;
+    raiseSpeechStartedEvent(text);
+    raiseSpeechEvent(QLatin1String("ttsSpeechReady"));
+    return true;
+}
+
+// Hands the queue over, in order, for as long as the speaker takes it; true
+// when it took all of it.
+static bool handOverQueue()
+{
+    while (!speechQueue.isEmpty()) {
+        if (!handOverSpeech(speechQueue.first())) {
+            return false;
+        }
+        speechQueue.removeFirst();
+    }
+    bSpeechQueueing = false;
+    return true;
+}
