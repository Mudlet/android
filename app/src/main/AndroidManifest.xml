<?xml version="1.0" encoding="utf-8"?>
<!-- The engine's service, and the permissions it needs, come from :engine-service's manifest -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A mouse or a touchpad does all a finger does, so Play offers the app to a Chromebook without a touchscreen -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".MudletApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Mudlet"
        android:allowBackup="true"
        android:backupAgent=".data.MudletBackupAgent"
        android:fullBackupOnly="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        tools:targetApi="33">

        <!-- A fold, a rotation, a split screen's or a desktop window's resize, a keyboard plugged in or taken away, or the
             system's own change of size lays the screen out again in place: a remade Activity would stop its link to
             the engine and take its window away mid-frame. A window dragged from wide to tall changes the orientation,
             and a keyboard plugged in or taken away the keyboard, whether it is hidden and on some the navigation -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A game's telnet:// link, as desktop Mudlet registers itself for: MainActivity asks before it connects -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="telnet" />
                <data android:scheme="telnets" />
            </intent-filter>
            <!-- A profile's .zip opened with Mudlet from another app, or shared with it: MainActivity shows what it holds and
                 imports it only once the player confirms. The types are ProfileArchive.MIME_TYPES -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Hands a shared map file, from the cache's map-files folder alone, to the app the player shares it with -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.mapfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/map_file_paths" />
        </provider>

        <!-- Hands a replay copied into the cache (ReplayShare, in ReplayRecording.kt) to the app the player shares it with -->
        <provider
            android:name="org.mudlet.android.ui.game.ReplayFileProvider"
            android:authorities="${applicationId}.replays"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/replay_files" />
        </provider>

        <!-- Hands a log copied into the cache (LogShare, in ProfileLogs.kt) to the app the player shares or opens it with -->
        <provider
            android:name="org.mudlet.android.ui.profiles.LogFileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/log_files" />
        </provider>
    </application>
</manifest>
